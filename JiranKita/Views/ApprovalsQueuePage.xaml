<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:JiranKita.Controls"
             xmlns:models="clr-namespace:JiranKita.Models"
             x:Class="JiranKita.Views.ApprovalsQueuePage"
             BackgroundColor="#FAFAF9"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto, Auto, *">

        <!-- ================= 1. TOP HEADER ================= -->
        <Border Grid.Row="0" 
                Stroke="#E7E5E4" 
                StrokeThickness="1" 
                BackgroundColor="White" 
                Padding="14, 10">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <controls:BackButton Grid.Column="0" />
                <Label Grid.Column="1" 
                       Text="APPROVALS QUEUE" 
                       FontSize="12" 
                       FontAttributes="Bold" 
                       TextColor="#1C1917" 
                       CharacterSpacing="1" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center" />
                <Border Grid.Column="2" 
                        StrokeShape="RoundRectangle 12" 
                        BackgroundColor="#F3E8FF" 
                        Stroke="#E9D5FF" 
                        Padding="8, 3">
                    <Label Text="JMB ADMIN" 
                           FontSize="9" 
                           FontAttributes="Bold" 
                           TextColor="#581C87" />
                </Border>
            </Grid>
        </Border>

        <!-- ================= 2. TAB SWITCHER ================= -->
        <Grid Grid.Row="1" 
              ColumnDefinitions="*, *" 
              ColumnSpacing="10" 
              Padding="14, 7" 
              BackgroundColor="#F5F5F4">

            <!-- Tab 1: Residents -->
            <Button x:Name="BtnTabResidents"
                    Grid.Column="0"
                    Text="👥 Residents"
                    Clicked="OnTabResidentsClicked"
                    BackgroundColor="#047857"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="12"
                    BorderWidth="1.5"
                    BorderColor="Transparent"
                    CornerRadius="10"
                    HeightRequest="42" />

            <!-- Tab 2: Incident Alerts -->
            <Button x:Name="BtnTabAlerts"
                    Grid.Column="1"
                    Text="⚠️ Incident Alerts"
                    Clicked="OnTabAlertsClicked"
                    BackgroundColor="White"
                    TextColor="#44403C"
                    FontAttributes="Bold"
                    FontSize="12"
                    BorderWidth="1.5"
                    BorderColor="#D6D3D1"
                    CornerRadius="10"
                    HeightRequest="42" />
        </Grid>

        <!-- ================= 3. CONTENT AREA ================= -->
        <Grid Grid.Row="2">

            <!-- SECTION A: RESIDENTS -->
            <Grid x:Name="SectionResidents" 
                  RowDefinitions="Auto, *" 
                  IsVisible="True" 
                  Padding="16, 12">

                <Label Grid.Row="0" 
                       x:Name="LblResidentsCount" 
                       Text="Loading pending applicants..." 
                       FontSize="11" 
                       TextColor="#78716C" 
                       Margin="2, 0, 0, 8" />

                <CollectionView Grid.Row="1" 
                                x:Name="CvPendingResidents" 
                                SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Border StrokeShape="RoundRectangle 16" Stroke="#E7E5E4" BackgroundColor="White" Padding="24" Margin="0, 20">
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Label Text="🎉" FontSize="34" HorizontalOptions="Center" />
                                <Label Text="No registrations pending review!" FontSize="12" FontAttributes="Bold" TextColor="#1C1917" HorizontalOptions="Center" />
                                <Label Text="All resident applicants have been approved." FontSize="10" TextColor="#78716C" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:UserModel">
                            <Border StrokeShape="RoundRectangle 16" Stroke="#E7E5E4" BackgroundColor="White" Padding="14" Margin="0, 0, 0, 10">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                        <Label Grid.Column="0" 
                                               Text="{Binding FullName}" 
                                               FontSize="13" 
                                               FontAttributes="Bold" 
                                               TextColor="#1C1917" 
                                               LineBreakMode="TailTruncation"
                                               VerticalOptions="Center" />
                                        <Border Grid.Column="1" StrokeShape="RoundRectangle 4" BackgroundColor="#FEF3C7" Stroke="#FDE68A" Padding="6, 2" VerticalOptions="Center">
                                            <Label Text="PENDING VERIFICATION" FontSize="8" FontAttributes="Bold" TextColor="#92400E" />
                                        </Border>
                                    </Grid>

                                    <!-- Unit & Identity Details -->
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding UnitNo, StringFormat='📍 Unit: {0}'}" FontSize="11" TextColor="#047857" FontAttributes="Bold" />
                                        <Label Text="{Binding IcNumber, StringFormat='🪪 MyKad: {0}'}" FontSize="10" TextColor="#57534E" />
                                        <Label Text="{Binding Phone, StringFormat='📞 Phone: {0}'}" FontSize="10" TextColor="#57534E" />
                                        <Label Text="{Binding OwnershipStatus, StringFormat='🏠 Status: {0}'}" FontSize="10" TextColor="#57534E" />
                                    </VerticalStackLayout>

                                    <!-- Attached Document -->
                                    <Border StrokeShape="RoundRectangle 8" BackgroundColor="#F5F5F4" Stroke="#E7E5E4" Padding="8, 4">
                                        <Label Text="{Binding ProofDocument, StringFormat='📄 Attached: {0}'}" FontSize="10" TextColor="#0369A1" LineBreakMode="TailTruncation" />
                                    </Border>

                                    <BoxView HeightRequest="1" Color="#F5F5F4" Margin="0, 2" />

                                    <!-- Action Buttons -->
                                    <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                                        <Button Grid.Column="0" 
                                                Text="✕ Reject" 
                                                Clicked="OnRejectResidentClicked" 
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#FFF1F2" 
                                                TextColor="#BE123C" 
                                                BorderColor="#FECDD3" 
                                                BorderWidth="1" 
                                                FontSize="11" 
                                                FontAttributes="Bold" 
                                                CornerRadius="10" 
                                                HeightRequest="36" />

                                        <Button Grid.Column="1" 
                                                Text="✓ Approve" 
                                                Clicked="OnApproveResidentClicked" 
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#047857" 
                                                TextColor="White" 
                                                FontSize="11" 
                                                FontAttributes="Bold" 
                                                CornerRadius="10" 
                                                HeightRequest="36" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>


            <!-- SECTION B: INCIDENT ALERTS -->
            <Grid x:Name="SectionAlerts" 
                  RowDefinitions="Auto, *" 
                  IsVisible="False" 
                  Padding="16, 12">

                <Label Grid.Row="0" 
                       x:Name="LblAlertsCount" 
                       Text="Loading incident reports..." 
                       FontSize="11" 
                       TextColor="#78716C" 
                       Margin="2, 0, 0, 8" />

                <CollectionView Grid.Row="1" 
                                x:Name="CvPendingAlerts" 
                                SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Border StrokeShape="RoundRectangle 16" Stroke="#E7E5E4" BackgroundColor="White" Padding="24" Margin="0, 20">
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Label Text="🛡️" FontSize="34" HorizontalOptions="Center" />
                                <Label Text="No emergency alerts pending review!" FontSize="12" FontAttributes="Bold" TextColor="#1C1917" HorizontalOptions="Center" />
                                <Label Text="The community area is currently secure and clear." FontSize="10" TextColor="#78716C" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:AlertModel">
                            <Border StrokeShape="RoundRectangle 16" Stroke="#FECDD3" BackgroundColor="#FFF1F2" Padding="14" Margin="0, 0, 0, 10">
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <Border Grid.Column="0" StrokeShape="RoundRectangle 4" BackgroundColor="#BE123C" Stroke="Transparent" Padding="6, 2">
                                            <Label Text="{Binding Category, StringFormat='PENDING: {0}'}" FontSize="8" FontAttributes="Bold" TextColor="White" />
                                        </Border>
                                        <Label Grid.Column="2" Text="{Binding TimeDisplay}" FontSize="9" TextColor="#9F1239" FontAttributes="Bold" VerticalOptions="Center" />
                                    </Grid>

                                    <!-- Alert Content -->
                                    <Label Text="{Binding Title}" FontSize="13" FontAttributes="Bold" TextColor="#1C1917" LineHeight="1.2" />
                                    <Label Text="{Binding Location, StringFormat='📍 {0}'}" FontSize="10" TextColor="#44403C" FontAttributes="Bold" />
                                    <Label Text="{Binding Advisory}" FontSize="10" TextColor="#57534E" LineHeight="1.2" />
                                    <Label Text="{Binding ReportedBy, StringFormat='Reported by: {0}'}" FontSize="9" TextColor="#78716C" FontAttributes="Italic" />

                                    <BoxView HeightRequest="1" Color="#FECDD3" Margin="0, 2" />

                                    <!-- Action Buttons -->
                                    <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                                        <Button Grid.Column="0" 
                                                Text="✕ Dismiss" 
                                                Clicked="OnRejectAlertClicked" 
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="White" 
                                                TextColor="#57534E" 
                                                BorderColor="#D6D3D1" 
                                                BorderWidth="1" 
                                                FontSize="11" 
                                                CornerRadius="10" 
                                                HeightRequest="36" />

                                        <Button Grid.Column="1" 
                                                Text="📢 Broadcast" 
                                                Clicked="OnApproveAlertClicked" 
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#BE123C" 
                                                TextColor="White" 
                                                FontSize="11" 
                                                FontAttributes="Bold" 
                                                CornerRadius="10" 
                                                HeightRequest="36" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

        </Grid>

    </Grid>

</ContentPage>