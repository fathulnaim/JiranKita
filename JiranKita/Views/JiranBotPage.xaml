<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:JiranKita.Controls"
             x:Class="JiranKita.Views.JiranBotPage"
             BackgroundColor="#FAFAF9"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- ================= 1. HEADER BAR ================= -->
        <Border Grid.Row="0"
                Stroke="#E7E5E4"
                StrokeThickness="1"
                BackgroundColor="White"
                Padding="14, 10">
            <Grid ColumnDefinitions="Auto, *, Auto">

                <!-- Back Navigation Button -->
                <controls:BackButton Grid.Column="0" />

                <!-- Header Bot Title -->
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="1">
                    <Label Text="ASK JIRANBOT" FontSize="12" FontAttributes="Bold" TextColor="#1C1917" CharacterSpacing="1" HorizontalOptions="Center" />
                    <Label Text="Neighbourhood AI Knowledge" FontSize="10" FontAttributes="Bold" TextColor="#065F46" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Right Info Icon -->
                <Label Grid.Column="2" Text="ℹ️" FontSize="16" VerticalOptions="Center" Margin="8,0" />
            </Grid>
        </Border>


        <!-- ================= 2. BOT CONVERSATION AREA ================= -->
        <ScrollView Grid.Row="1" Padding="16">
            <VerticalStackLayout Spacing="16">

                <!-- BOT WELCOME BANNER [DB: user.first_name] -->
                <Border StrokeShape="RoundRectangle 16" Stroke="#A7F3D0" BackgroundColor="#ECFDF5" Padding="14">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="🤖" FontSize="26" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Hello Fathul! How can I assist you?" FontSize="12" FontAttributes="Bold" TextColor="#1C1917" />
                            <Label Text="Ask about rules, garbage disposal, contacts, or facilities." FontSize="10" TextColor="#57534E" LineHeight="1.2" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- QUICK PROMPTS / FREQUENT INQUIRIES -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="COMMON INQUIRIES" FontSize="11" FontAttributes="Bold" TextColor="#57534E" CharacterSpacing="1" />

                    <!-- Quick Prompt 1: Bulky Waste Schedule -->
                    <Border StrokeShape="RoundRectangle 12" Stroke="#E7E5E4" BackgroundColor="White" Padding="12, 10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnQuickPromptTapped" CommandParameter="Bulky Waste Schedule" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="📅 Bulky Waste Collection Schedule" FontSize="11" TextColor="#292524" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="➔" FontSize="11" TextColor="#A8A29E" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Quick Prompt 2: Swimming Pool Rules -->
                    <Border StrokeShape="RoundRectangle 12" Stroke="#E7E5E4" BackgroundColor="White" Padding="12, 10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnQuickPromptTapped" CommandParameter="Swimming Pool Rules" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="🏊 Swimming Pool Hours &amp; Rules" FontSize="11" TextColor="#292524" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="➔" FontSize="11" TextColor="#A8A29E" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Quick Prompt 3: Visitor Parking -->
                    <Border StrokeShape="RoundRectangle 12" Stroke="#E7E5E4" BackgroundColor="White" Padding="12, 10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnQuickPromptTapped" CommandParameter="Visitor Parking Rules" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="🚗 Visitor Overnight Parking Rules" FontSize="11" TextColor="#292524" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="➔" FontSize="11" TextColor="#A8A29E" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>


                <!-- USER QUERY BUBBLE -->
                <Border HorizontalOptions="End"
                        StrokeShape="RoundRectangle 16 16 0 16"
                        BackgroundColor="#047857"
                        Stroke="Transparent"
                        Padding="14, 10"
                        MaximumWidthRequest="280">
                    <Label Text="&quot;Can I book the BBQ pit this Sunday and what is the deposit fee?&quot;" 
                           FontSize="11" 
                           TextColor="White" 
                           LineHeight="1.2" />
                </Border>


                <!-- JIRANBOT AI RESPONSE CARD [DB/AI Engine: JiranBot RAG Knowledge Response] -->
                <Border StrokeShape="RoundRectangle 16" Stroke="#6EE7B7" StrokeThickness="1.5" BackgroundColor="White" Padding="14">
                    <VerticalStackLayout Spacing="10">

                        <!-- Response Title -->
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="✨" FontSize="13" TextColor="#047857" />
                            <Label Text="BBQ Pit Booking Guidelines:" FontSize="11" FontAttributes="Bold" TextColor="#065F46" />
                        </HorizontalStackLayout>

                        <!-- Rule List Items -->
                        <VerticalStackLayout Spacing="4" Padding="6, 0">
                            <Label Text="• Slot Available: Sunday 5:00 PM – 10:00 PM" FontSize="10" TextColor="#44403C" />
                            <Label Text="• Booking Fee: RM 50 (Non-refundable cleaning)" FontSize="10" TextColor="#44403C" />
                            <Label Text="• Deposit: RM 100 (Refundable upon clean handover)" FontSize="10" TextColor="#44403C" />
                            <Label Text="• Notice Period: Requires at least 3 days advance booking" FontSize="10" TextColor="#44403C" />
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="#F5F5F4" Margin="0, 2" />

                        <!-- Source Citation & Action Button -->
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="Source: JMB By-Law 2024 (Sec 4.2)" FontSize="9" TextColor="#78716C" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="Book Slot Now" BackgroundColor="#047857" TextColor="White" FontSize="10" FontAttributes="Bold" CornerRadius="8" HeightRequest="32" Padding="10, 0" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>


        <!-- ================= 3. INPUT ENTRY FOOTER ================= -->
        <Border Grid.Row="2"
                Stroke="#E7E5E4"
                StrokeThickness="1"
                BackgroundColor="White"
                Padding="12, 8">
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">

                <Border Grid.Column="0" StrokeShape="RoundRectangle 12" Stroke="#D6D3D1" BackgroundColor="#FAFAF9" Padding="12, 0">
                    <Entry x:Name="TxtBotQuery" 
                           Placeholder="Ask about facilities, rules, contacts..." 
                           PlaceholderColor="#A8A29E" 
                           FontSize="12" 
                           TextColor="#1C1917"
                           Focused="OnInputFocused" 
                           Unfocused="OnInputUnfocused" />
                </Border>

                <Border Grid.Column="1" StrokeShape="RoundRectangle 12" BackgroundColor="#047857" Stroke="Transparent" HeightRequest="38" WidthRequest="38">
                    <Label Text="➤" FontSize="14" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

            </Grid>
        </Border>

    </Grid>
</ContentPage>