<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:JiranKita.Controls"
             xmlns:models="clr-namespace:JiranKita.Models"
             x:Class="JiranKita.Views.JiranBotPage"
             BackgroundColor="#FAFAF9"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- ================= 1. HEADER SECTION ================= -->
        <Border Grid.Row="0" Stroke="#E7E5E4" StrokeThickness="1" BackgroundColor="White" Padding="14, 10">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <controls:BackButton Grid.Column="0" />

                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="1">
                    <Label Text="ASK JIRANBOT" FontSize="12" FontAttributes="Bold" TextColor="#1C1917" CharacterSpacing="1" HorizontalOptions="Center" />
                    <Label Text="Neighbourhood AI Knowledge ⚡" FontSize="10" FontAttributes="Bold" TextColor="#065F46" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <Label Grid.Column="2" Text="ℹ️" FontSize="16" VerticalOptions="Center" Margin="8,0" />
            </Grid>
        </Border>


        <!-- ================= 2. CONVERSATION VIEW (COLLECTIONVIEW) ================= -->
        <CollectionView x:Name="CvBotMessages"
                        Grid.Row="1"
                        SelectionMode="None"
                        Margin="14, 10">

            <!-- LIST HEADER: WELCOME CARD & POPULAR TOPICS -->
            <CollectionView.Header>
                <VerticalStackLayout Spacing="14" Margin="0, 0, 0, 12">

                    <!-- Dynamic Welcome Banner -->
                    <Border StrokeShape="RoundRectangle 16" Stroke="#A7F3D0" BackgroundColor="#ECFDF5" Padding="14">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="🤖" FontSize="26" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label x:Name="LblBotGreeting" Text="Hello! How can I assist you?" FontSize="12" FontAttributes="Bold" TextColor="#1C1917" />
                                <Label Text="Ask me anything about condo rules, facilities, garbage schedules, or JMB fees." FontSize="10" TextColor="#57534E" LineHeight="1.2" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Popular Topic Prompt Buttons -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="POPULAR TOPICS" FontSize="10" FontAttributes="Bold" TextColor="#78716C" CharacterSpacing="1" />
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="6">
                                <Button Text="🏊 Swimming Pool" Clicked="OnQuickPromptClicked" BackgroundColor="White" TextColor="#44403C" BorderColor="#D6D3D1" BorderWidth="1" FontSize="11" CornerRadius="8" HeightRequest="32" Padding="10, 0" />
                                <Button Text="🍖 BBQ Pit" Clicked="OnQuickPromptClicked" BackgroundColor="White" TextColor="#44403C" BorderColor="#D6D3D1" BorderWidth="1" FontSize="11" CornerRadius="8" HeightRequest="32" Padding="10, 0" />
                                <Button Text="🚗 Visitor Parking" Clicked="OnQuickPromptClicked" BackgroundColor="White" TextColor="#44403C" BorderColor="#D6D3D1" BorderWidth="1" FontSize="11" CornerRadius="8" HeightRequest="32" Padding="10, 0" />
                                <Button Text="🗑️ Bulky Waste" Clicked="OnQuickPromptClicked" BackgroundColor="White" TextColor="#44403C" BorderColor="#D6D3D1" BorderWidth="1" FontSize="11" CornerRadius="8" HeightRequest="32" Padding="10, 0" />
                                <Button Text="🔨 Renovation" Clicked="OnQuickPromptClicked" BackgroundColor="White" TextColor="#44403C" BorderColor="#D6D3D1" BorderWidth="1" FontSize="11" CornerRadius="8" HeightRequest="32" Padding="10, 0" />
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </CollectionView.Header>

            <!-- ITEM TEMPLATE: USER BUBBLE VS BOT RESPONSE CARD -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:BotMessageModel">
                    <Grid Margin="0, 4">

                        <!-- A. USER MESSAGE (RIGHT SIDE - EMERALD GREEN BUBBLE) -->
                        <VerticalStackLayout HorizontalOptions="End" MaximumWidthRequest="280" Spacing="2" IsVisible="{Binding IsUser}">
                            <Border StrokeShape="RoundRectangle 16 16 0 16" BackgroundColor="#047857" Stroke="Transparent" Padding="12, 9">
                                <Label Text="{Binding MessageText}" FontSize="12" TextColor="White" LineHeight="1.2" />
                            </Border>
                            <Label Text="{Binding TimeDisplay}" FontSize="9" TextColor="#A8A29E" HorizontalOptions="End" Margin="0, 0, 4, 0" />
                        </VerticalStackLayout>

                        <!-- B. JIRANBOT AI RESPONSE (LEFT SIDE - WHITE CARD WITH EMERALD STROKE) -->
                        <VerticalStackLayout HorizontalOptions="Start" MaximumWidthRequest="300" Spacing="3" IsVisible="{Binding IsBot}">
                            <Border StrokeShape="RoundRectangle 16 16 16 0" Stroke="#6EE7B7" StrokeThickness="1.5" BackgroundColor="White" Padding="14">
                                <VerticalStackLayout Spacing="8">

                                    <!-- Header Title -->
                                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                        <Label Text="🤖" FontSize="13" />
                                        <Label Text="{Binding Title}" FontSize="11" FontAttributes="Bold" TextColor="#065F46" VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <!-- Main Text Response -->
                                    <Label Text="{Binding MessageText}" FontSize="11" TextColor="#44403C" LineHeight="1.3" />

                                    <!-- Clean Rule Points Display (Single Label via FormattedRulePoints) -->
                                    <Label Text="{Binding FormattedRulePoints}" 
                                           FontSize="10" 
                                           TextColor="#292524" 
                                           LineHeight="1.4"
                                           IsVisible="{Binding HasRulePoints}" />

                                    <BoxView HeightRequest="1" Color="#F5F5F4" Margin="0, 2" />

                                    <!-- Source Citation & Action Button Footer -->
                                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                        <Label Grid.Column="0" Text="{Binding SourceCitation}" FontSize="9" TextColor="#78716C" VerticalOptions="Center" />
                                        <Button Grid.Column="1" 
                                                Text="{Binding ActionButtonText}" 
                                                Clicked="OnBotActionClicked"
                                                IsVisible="{Binding HasActionButton}"
                                                BackgroundColor="#047857" 
                                                TextColor="White" 
                                                FontSize="9" 
                                                FontAttributes="Bold" 
                                                CornerRadius="8" 
                                                HeightRequest="28" 
                                                Padding="8, 0" />
                                    </Grid>

                                </VerticalStackLayout>
                            </Border>

                            <Label Text="{Binding TimeDisplay}" FontSize="9" TextColor="#A8A29E" Margin="4, 0, 0, 0" />
                        </VerticalStackLayout>

                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>


        <!-- ================= 3. QUERY INPUT FOOTER ================= -->
        <Border Grid.Row="2" Stroke="#E7E5E4" StrokeThickness="1" BackgroundColor="White" Padding="12, 8">
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">

                <Border Grid.Column="0" StrokeShape="RoundRectangle 12" Stroke="#D6D3D1" BackgroundColor="#FAFAF9" Padding="12, 0">
                    <Entry x:Name="TxtBotQuery" 
                           Placeholder="Ask about facilities, rules, contacts..." 
                           PlaceholderColor="#A8A29E" 
                           FontSize="12" 
                           TextColor="#1C1917" />
                </Border>

                <Border Grid.Column="1" StrokeShape="RoundRectangle 12" BackgroundColor="#047857" HeightRequest="38" WidthRequest="38">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSendQueryClicked" />
                    </Border.GestureRecognizers>
                    <Label Text="➤" FontSize="14" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

            </Grid>
        </Border>

    </Grid>

</ContentPage>