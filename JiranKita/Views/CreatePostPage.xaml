<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JiranKita.Views.CreatePostPage"
             BackgroundColor="#FAFAF9"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- Header -->
        <Border Grid.Row="0" Stroke="#E7E5E4" StrokeThickness="1" BackgroundColor="White" Padding="16, 12">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <Label Grid.Column="0" Text="Cancel" TextColor="#78716C" FontSize="12" FontAttributes="Bold" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCancelClicked" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Grid.Column="1" Text="CREATE NEW POST" FontSize="12" FontAttributes="Bold" TextColor="#1C1917" CharacterSpacing="1" HorizontalOptions="Center" VerticalOptions="Center" />
                <BoxView Grid.Column="2" WidthRequest="40" Color="white" />
            </Grid>
        </Border>

        <!-- Borang Input (Scrollable) -->
        <ScrollView Grid.Row="1" Padding="16">
            <VerticalStackLayout Spacing="16">

                <!-- Kategori Pilihan -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Choose Category *" FontSize="12" FontAttributes="Bold" TextColor="#44403C" />
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="6">
                            <Border StrokeShape="RoundRectangle 8" BackgroundColor="#D97706" Stroke="Transparent" Padding="10, 6">
                                <Label Text="Lost &amp; Found" FontSize="11" FontAttributes="Bold" TextColor="White" />
                            </Border>
                            <Border StrokeShape="RoundRectangle 8" BackgroundColor="White" Stroke="#D6D3D1" Padding="10, 6">
                                <Label Text="Road &amp; Maintenance" FontSize="11" TextColor="#44403C" />
                            </Border>
                            <Border StrokeShape="RoundRectangle 8" BackgroundColor="White" Stroke="#D6D3D1" Padding="10, 6">
                                <Label Text="Events" FontSize="11" TextColor="#44403C" />
                            </Border>
                            <Border StrokeShape="RoundRectangle 8" BackgroundColor="White" Stroke="#D6D3D1" Padding="10, 6">
                                <Label Text="Official" FontSize="11" TextColor="#44403C" />
                            </Border>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>

                <!-- Tajuk Pos -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Post Title *" FontSize="12" FontAttributes="Bold" TextColor="#44403C" />
                    <Border StrokeShape="RoundRectangle 12" Stroke="#D6D3D1" BackgroundColor="White" Padding="12, 2">
                        <Entry x:Name="TxtTitle" Text="Stray Kitten Found at Guardhouse 2" MaxLength="70" FontSize="12" TextColor="#1C1917" />
                    </Border>
                    <Label Text="34 / 70 characters" FontSize="10" TextColor="#78716C" HorizontalOptions="End" />
                </VerticalStackLayout>

                <!-- Penerangan Terperinci (Editor Textarea) -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Detailed Description *" FontSize="12" FontAttributes="Bold" TextColor="#44403C" />
                    <Border StrokeShape="RoundRectangle 12" Stroke="#D6D3D1" BackgroundColor="White" Padding="12">
                        <Editor x:Name="TxtDescription"
                                Text="Found a small calico kitten sheltering near Guardhouse 2 entrance. Has no collar. Left with safety officer on duty." 
                                HeightRequest="90" 
                                FontSize="12" 
                                TextColor="#1C1917" />
                    </Border>
                </VerticalStackLayout>

                <!-- Lampiran Gambar (Kamera & Galeri) -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Attach Photos (Max 4)" FontSize="12" FontAttributes="Bold" TextColor="#44403C" />
                    <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8">
                        <!-- Kamera -->
                        <Border Grid.Column="0" StrokeShape="RoundRectangle 12" Stroke="#D6D3D1" StrokeDashArray="4, 2" BackgroundColor="White" HeightRequest="64">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCameraClicked" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                                <Label Text="📷" FontSize="16" HorizontalOptions="Center" />
                                <Label Text="Camera" FontSize="10" TextColor="#44403C" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Galeri -->
                        <Border Grid.Column="1" StrokeShape="RoundRectangle 12" Stroke="#D6D3D1" StrokeDashArray="4, 2" BackgroundColor="White" HeightRequest="64">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnGalleryClicked" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                                <Label Text="🖼️" FontSize="16" HorizontalOptions="Center" />
                                <Label Text="Gallery" FontSize="10" TextColor="#44403C" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Item Gambar Terpasang -->
                        <Border Grid.Column="2" StrokeShape="RoundRectangle 12" Stroke="#E7E5E4" BackgroundColor="White" HeightRequest="64">
                            <Label Text="Photo_1.jpg" FontSize="10" TextColor="#78716C" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <!-- Pilih Lokasi -->
                <Border StrokeShape="RoundRectangle 12" Stroke="#D6D3D1" BackgroundColor="White" Padding="12, 10">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="📍 Location: Block C Lobby" FontSize="11" FontAttributes="Bold" TextColor="#1C1917" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Change" FontSize="11" FontAttributes="Bold" TextColor="#047857" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Pilihan Checkbox -->
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="8">
                        <CheckBox IsChecked="True" Color="#047857" />
                        <Label Text="Allow neighbours to contact me directly" FontSize="11" TextColor="#44403C" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="8">
                        <CheckBox Color="#E11D48" />
                        <Label Text="Mark as Urgent Geofence Siren Broadcast" FontSize="11" FontAttributes="Bold" TextColor="#BE123C" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Butang Publish Di Bawah -->
        <Border Grid.Row="2" Stroke="#E7E5E4" StrokeThickness="1" BackgroundColor="White" Padding="16, 10">
            <Button Text="🚀 PUBLISH TO PRECINCT" Clicked="OnPublishClicked" BackgroundColor="#047857" TextColor="White" FontAttributes="Bold" FontSize="12" CornerRadius="12" HeightRequest="48" />
        </Border>

    </Grid>

</ContentPage>