<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JiranKita.Views.CreatePostPage"
             BackgroundColor="#FAFAF9"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- 1. Header (Butang Cancel Berfungsi) -->
        <Border Grid.Row="0" Stroke="#E7E5E4" StrokeThickness="1" BackgroundColor="White" Padding="12, 10">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <Button Grid.Column="0" 
                        Text="Cancel" 
                        Clicked="OnCancelClicked" 
                        BackgroundColor="Transparent" 
                        TextColor="#78716C" 
                        FontAttributes="Bold" 
                        FontSize="12" 
                        HeightRequest="36" />
                <Label Grid.Column="1" Text="CREATE NEW POST" FontSize="12" FontAttributes="Bold" TextColor="#1C1917" CharacterSpacing="1" HorizontalOptions="Center" VerticalOptions="Center" />
                <BoxView Grid.Column="2" WidthRequest="48" Color="Transparent" />
            </Grid>
        </Border>

        <!-- 2. Borang Input (Scrollable) -->
        <ScrollView Grid.Row="1" Padding="16">
            <VerticalStackLayout Spacing="16">

                <!-- 1. PILIH KATEGORI (BUTANG RESPONSIF) -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Choose Category *" FontSize="12" FontAttributes="Bold" TextColor="#44403C" />
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="8">
                            <Button x:Name="BtnCatLostFound" Text="Lost &amp; Found" Clicked="OnCategoryClicked" BackgroundColor="#D97706" TextColor="White" FontAttributes="Bold" FontSize="11" CornerRadius="8" HeightRequest="36" Padding="12, 0" />
                            <Button x:Name="BtnCatRoad" Text="Road &amp; Maintenance" Clicked="OnCategoryClicked" BackgroundColor="White" TextColor="#44403C" BorderColor="#D6D3D1" BorderWidth="1" FontSize="11" CornerRadius="8" HeightRequest="36" Padding="12, 0" />
                            <Button x:Name="BtnCatEvents" Text="Events" Clicked="OnCategoryClicked" BackgroundColor="White" TextColor="#44403C" BorderColor="#D6D3D1" BorderWidth="1" FontSize="11" CornerRadius="8" HeightRequest="36" Padding="12, 0" />
                            <Button x:Name="BtnCatOfficial" Text="Official" Clicked="OnCategoryClicked" BackgroundColor="White" TextColor="#44403C" BorderColor="#D6D3D1" BorderWidth="1" FontSize="11" CornerRadius="8" HeightRequest="36" Padding="12, 0" />
                            <Button x:Name="BtnCatEmergency" Text="Emergency" Clicked="OnCategoryClicked" BackgroundColor="White" TextColor="#44403C" BorderColor="#D6D3D1" BorderWidth="1" FontSize="11" CornerRadius="8" HeightRequest="36" Padding="12, 0" />
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>

                <!-- 2. TAJUK (KOSONG DENGAN PLACEHOLDER) -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Post Title *" FontSize="12" FontAttributes="Bold" TextColor="#44403C" />
                    <Border StrokeShape="RoundRectangle 12" Stroke="#D6D3D1" BackgroundColor="White" Padding="12, 2">
                        <Entry x:Name="TxtTitle" 
                               Text="" 
                               Placeholder="Contoh: Kucing Hilang / Lampu Jalan Rosak" 
                               PlaceholderColor="#A8A29E" 
                               MaxLength="70" 
                               FontSize="12" 
                               TextColor="#1C1917"
                               TextChanged="OnTitleTextChanged" />
                    </Border>
                    <Label x:Name="LblTitleCount" Text="0 / 70 characters" FontSize="10" TextColor="#78716C" HorizontalOptions="End" />
                </VerticalStackLayout>

                <!-- 3. DESKRIPSI (KOSONG DENGAN PLACEHOLDER) -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Detailed Description *" FontSize="12" FontAttributes="Bold" TextColor="#44403C" />
                    <Border StrokeShape="RoundRectangle 12" Stroke="#D6D3D1" BackgroundColor="White" Padding="12">
                        <Editor x:Name="TxtDescription"
                                Text=""
                                Placeholder="Huraikan maklumat aduan atau situasi anda di sini..." 
                                PlaceholderColor="#A8A29E"
                                HeightRequest="95" 
                                FontSize="12" 
                                TextColor="#1C1917" />
                    </Border>
                </VerticalStackLayout>

                <!-- 4. LAMPIRAN GAMBAR & PRATONTON -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Attach Photo" FontSize="12" FontAttributes="Bold" TextColor="#44403C" />
                    <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8">
                        <!-- Kamera -->
                        <Border Grid.Column="0" StrokeShape="RoundRectangle 12" Stroke="#D6D3D1" StrokeDashArray="4, 2" BackgroundColor="White" HeightRequest="64">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCameraClicked" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                                <Label Text="📷" FontSize="16" HorizontalOptions="Center" />
                                <Label Text="Camera" FontSize="10" TextColor="#44403C" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Galeri -->
                        <Border Grid.Column="1" StrokeShape="RoundRectangle 12" Stroke="#D6D3D1" StrokeDashArray="4, 2" BackgroundColor="White" HeightRequest="64">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnGalleryClicked" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                                <Label Text="🖼️" FontSize="16" HorizontalOptions="Center" />
                                <Label Text="Gallery" FontSize="10" TextColor="#44403C" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- KOTAK PRATONTON GAMBAR SEBENAR (Muncul bila ada gambar) -->
                        <Grid x:Name="AttachedPhotoCard" Grid.Column="2" HeightRequest="64" IsVisible="False">
                            <Border StrokeShape="RoundRectangle 12" Stroke="#047857" StrokeThickness="1.5" BackgroundColor="#F5F5F4" Padding="0">
                                <Image x:Name="ImgPreview" Aspect="AspectFill" />
                            </Border>

                            <Border StrokeShape="RoundRectangle 10" BackgroundColor="#E11D48" HeightRequest="20" WidthRequest="20" HorizontalOptions="End" VerticalOptions="Start" TranslationX="4" TranslationY="-4">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRemovePhotoClicked" />
                                </Border.GestureRecognizers>
                                <Label Text="✕" TextColor="White" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </Grid>
                </VerticalStackLayout>

                <!-- Lokasi (Kekal) -->
                <Border StrokeShape="RoundRectangle 12" Stroke="#D6D3D1" BackgroundColor="White" Padding="12, 10">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="📍 Location: Block C Lobby" FontSize="11" FontAttributes="Bold" TextColor="#1C1917" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Change" FontSize="11" FontAttributes="Bold" TextColor="#047857" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- 5. CHECKBOX BERFUNGSI -->
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="8">
                        <CheckBox x:Name="ChkAllowContact" IsChecked="True" Color="#047857" />
                        <Label Text="Allow neighbours to contact me directly" FontSize="11" TextColor="#44403C" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="8">
                        <CheckBox x:Name="ChkUrgentSiren" IsChecked="False" Color="#E11D48" />
                        <Label Text="Mark as Urgent Geofence Siren Broadcast" FontSize="11" FontAttributes="Bold" TextColor="#BE123C" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Butang Publish -->
        <Border Grid.Row="2" Stroke="#E7E5E4" StrokeThickness="1" BackgroundColor="White" Padding="16, 10">
            <Button Text="🚀 PUBLISH TO COMMUNITY" Clicked="OnPublishClicked" BackgroundColor="#047857" TextColor="White" FontAttributes="Bold" FontSize="12" CornerRadius="12" HeightRequest="48" />
        </Border>

    </Grid>

</ContentPage>