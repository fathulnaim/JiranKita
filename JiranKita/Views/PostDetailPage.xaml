<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:JiranKita.Controls"
             xmlns:models="clr-namespace:JiranKita.Models"
             xmlns:views="clr-namespace:JiranKita.Views"
             x:Class="JiranKita.Views.PostDetailPage"
             x:DataType="views:PostDetailPage"
             BackgroundColor="#FAFAF9"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- Header -->
        <Border Grid.Row="0" Stroke="#E7E5E4" StrokeThickness="1" BackgroundColor="White" Padding="14, 10">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <controls:BackButton Grid.Column="0" />
                <Label Grid.Column="1" Text="POST DETAILS" FontSize="11" FontAttributes="Bold" TextColor="#78716C" CharacterSpacing="1" HorizontalOptions="Center" VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Kandungan Dinamik Pos -->
        <ScrollView Grid.Row="1" Padding="16">
            <VerticalStackLayout Spacing="14">

                <!-- GAMBAR POS SEBENAR (ISU 8 SELESAI: Hanya muncul jika ada gambar) -->
                <Border StrokeShape="RoundRectangle 16" Stroke="#E7E5E4" BackgroundColor="#F5F5F4" HeightRequest="180" IsVisible="{Binding Post.HasImage}">
                    <Image Source="{Binding Post.ImageUrl}" Aspect="AspectFill" />
                </Border>

                <!-- Kategori & Status -->
                <Grid ColumnDefinitions="Auto, *">
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 4" BackgroundColor="#FEF3C7" Stroke="#FDE68A" Padding="8, 2">
                        <Label Text="{Binding Post.Category}" FontSize="9" FontAttributes="Bold" TextColor="#92400E" />
                    </Border>
                    <Border Grid.Column="1" StrokeShape="RoundRectangle 4" BackgroundColor="#ECFDF5" Stroke="#A7F3D0" Padding="8, 2" HorizontalOptions="End">
                        <Label Text="{Binding Post.Status, StringFormat='Status: {0}'}" FontSize="9" FontAttributes="Bold" TextColor="#065F46" />
                    </Border>
                </Grid>

                <!-- Tajuk Sebenar -->
                <Label Text="{Binding Post.Title}" FontSize="15" FontAttributes="Bold" TextColor="#1C1917" LineHeight="1.2" />

                <!-- Maklumat Penulis & Tarikh Sebenar -->
                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8" Padding="0, 4">
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 12" BackgroundColor="#047857" HeightRequest="32" WidthRequest="32">
                        <Label Text="{Binding Post.AuthorInitials}" TextColor="White" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                        <Label Text="{Binding Post.AuthorName}" FontSize="12" FontAttributes="Bold" TextColor="#1C1917" />
                        <Label Text="{Binding Post.AuthorUnit, StringFormat='{0} · Verified'}" FontSize="9" TextColor="#047857" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="{Binding Post.FormattedDate}" FontSize="9" TextColor="#78716C" VerticalOptions="Center" />
                </Grid>

                <BoxView HeightRequest="1" Color="#E7E5E4" />

                <!-- Huraian Sebenar -->
                <Label Text="{Binding Post.Description}" FontSize="12" TextColor="#44403C" LineHeight="1.3" />

                <!-- Butang Hubungi Penulis -->
                <Button Text="📞 Contact Author (WhatsApp / Call)" Clicked="OnContactOwnerClicked" BackgroundColor="#047857" TextColor="White" FontAttributes="Bold" FontSize="11" CornerRadius="12" HeightRequest="44" />

                <!-- Senarai Komen Sebenar dari Firebase -->
                <VerticalStackLayout Spacing="8" Margin="0, 8, 0, 0">
                    <Label Text="Resident Replies" FontSize="12" FontAttributes="Bold" TextColor="#1C1917" />

                    <CollectionView ItemsSource="{Binding Comments}" SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Border StrokeShape="RoundRectangle 12" Stroke="#E7E5E4" BackgroundColor="White" Padding="14">
                                <Label Text="Belum ada komen. Jadilah jiran pertama yang membalas!" FontSize="11" TextColor="#78716C" HorizontalTextAlignment="Center" />
                            </Border>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:CommentModel">
                                <Border StrokeShape="RoundRectangle 12" Stroke="#E7E5E4" BackgroundColor="White" Padding="12" Margin="0, 0, 0, 8">
                                    <VerticalStackLayout Spacing="3">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <Label Grid.Column="0" Text="{Binding AuthorName}" FontSize="11" FontAttributes="Bold" TextColor="#1C1917" />
                                            <Label Grid.Column="1" Text="{Binding TimeAgoDisplay}" FontSize="9" TextColor="#78716C" />
                                        </Grid>
                                        <Label Text="{Binding CommentText}" FontSize="11" TextColor="#44403C" LineHeight="1.2" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Kotak Taip Komen Balasan -->
        <Border Grid.Row="2" Stroke="#E7E5E4" StrokeThickness="1" BackgroundColor="White" Padding="12, 8">
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                <Border Grid.Column="0" StrokeShape="RoundRectangle 12" Stroke="#D6D3D1" BackgroundColor="#FAFAF9" Padding="12, 0">
                    <Entry x:Name="TxtReply" Placeholder="Write a helpful reply..." PlaceholderColor="#A8A29E" FontSize="11" TextColor="#1C1917" />
                </Border>
                <Border Grid.Column="1" StrokeShape="RoundRectangle 12" BackgroundColor="#047857" HeightRequest="38" WidthRequest="38">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSendReplyClicked" />
                    </Border.GestureRecognizers>
                    <Label Text="➤" TextColor="White" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>
        </Border>

    </Grid>

</ContentPage>