<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:JiranKita.Controls"
             x:Class="JiranKita.Views.login"
             BackgroundColor="#FAFAF9"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Butang back dan bahasa -->
            <Grid ColumnDefinitions="Auto, *" Margin="0,10,0,5">

                <controls:BackButton Grid.Column="0" />

                <!-- Pilih bahasa -->
                <HorizontalStackLayout Grid.Column="1" 
                                       HorizontalOptions="End" 
                                       VerticalOptions="Center" 
                                       Spacing="6">
                    <Label Text="Language:" 
                           FontSize="12" 
                           TextColor="#78716C" 
                           VerticalOptions="Center" />
                    <Border StrokeShape="RoundRectangle 6" 
                            Stroke="#E7E5E4" 
                            BackgroundColor="White" 
                            Padding="8, 2">
                        <Label Text="EN" 
                               FontSize="11" 
                               FontAttributes="Bold" 
                               TextColor="#065F46" />
                    </Border>
                </HorizontalStackLayout>
            </Grid>

            <!-- Welcome user kat sini -->
            <VerticalStackLayout Spacing="4" Margin="0, 5, 0, 5">
                <Label Text="Welcome Neighbour!" 
                       FontSize="20" 
                       FontAttributes="Bold" 
                       TextColor="#1C1917" />
                <Label Text="Sign in to your registered residency precinct" 
                       FontSize="12" 
                       TextColor="#78716C" />
            </VerticalStackLayout>

            <!-- Butang signin signup -->
            <Border StrokeShape="RoundRectangle 16"
                    Stroke="#E7E5E4"
                    BackgroundColor="#E7E5E4"
                    Padding="3">
                <Grid ColumnDefinitions="*, *">
                    <!-- Boldkan apa yang aktif -->
                    <Border Grid.Column="0" 
                            StrokeShape="RoundRectangle 12" 
                            Stroke="Transparent" 
                            BackgroundColor="White" 
                            Padding="0, 8">
                        <Label Text="Sign In" 
                               TextColor="#1C1917" 
                               FontAttributes="Bold" 
                               FontSize="12" 
                               HorizontalOptions="Center" />
                    </Border>
                    <!-- Tab signup -->
                    <Border Grid.Column="1" 
                            StrokeShape="RoundRectangle 12" 
                            Stroke="Transparent" 
                            BackgroundColor="Transparent" 
                            Padding="0, 8">
                        <Label Text="Sign Up" 
                               TextColor="#78716C" 
                               FontAttributes="Bold" 
                               FontSize="12" 
                               HorizontalOptions="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- Tempat isi maklumat -->

            <!-- Email sahaja -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Residential/User Email" 
                       FontSize="12" 
                       TextColor="#44403C" 
                       FontAttributes="Bold" />
                <Border StrokeShape="RoundRectangle 12" 
                        Stroke="#D6D3D1" 
                        BackgroundColor="White" 
                        Padding="12, 2">
                    <Entry Placeholder="Enter residential/user email"
                           PlaceholderColor="#A8A29E"
                           FontSize="13"
                           TextColor="#1C1917" />
                </Border>
            </VerticalStackLayout>

            <!-- Tempat password -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Password" 
                       FontSize="12" 
                       TextColor="#44403C" 
                       FontAttributes="Bold" />
                <Border StrokeShape="RoundRectangle 12" 
                        Stroke="#D6D3D1" 
                        BackgroundColor="White" 
                        Padding="12, 2">
                    <Grid ColumnDefinitions="*, Auto">
                        <Entry Grid.Column="0" 
                               Placeholder="Enter password"
                               PlaceholderColor="#A8A29E"
                               IsPassword="True" 
                               FontSize="13" 
                               TextColor="#1C1917" />
                        <Label Grid.Column="1" 
                               Text="👁" 
                               FontSize="14" 
                               VerticalOptions="Center" 
                               TextColor="#A8A29E" 
                               Margin="0,0,5,0" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- checkbox ingat dan lupa password -->
            <Grid ColumnDefinitions="*, Auto">
                <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                    <CheckBox IsChecked="True" Color="#047857" />
                    <Label Text="Keep me logged in" 
                           FontSize="12" 
                           TextColor="#57534E" 
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Label Grid.Column="1" 
                       Text="Forgot password?" 
                       TextColor="#065F46" 
                       FontAttributes="Bold" 
                       FontSize="12" 
                       VerticalOptions="Center" />
            </Grid>

            <!-- Buton sign up -->
            <Button Text="SIGN IN TO JIRANKITA" 
                    BackgroundColor="#047857" 
                    TextColor="White" 
                    FontAttributes="Bold" 
                    FontSize="12" 
                    CornerRadius="12" 
                    HeightRequest="48" 
                    Margin="0, 8, 0, 0" />

            <!-- Option lain -->
            <Grid ColumnDefinitions="*, Auto, *" Margin="0, 6">
                <BoxView Grid.Column="0" HeightRequest="1" Color="#E7E5E4" VerticalOptions="Center" />
                <Label Grid.Column="1" 
                       Text="Or continue with" 
                       FontSize="11" 
                       TextColor="#A8A29E" 
                       Margin="10, 0" />
                <BoxView Grid.Column="2" HeightRequest="1" Color="#E7E5E4" VerticalOptions="Center" />
            </Grid>

            <!-- Button guna google -->
            <Border StrokeShape="RoundRectangle 12" 
                    Stroke="#E7E5E4" 
                    BackgroundColor="White" 
                    HeightRequest="44">
                <HorizontalStackLayout HorizontalOptions="Center" 
                                       VerticalOptions="Center" 
                                       Spacing="8">
                    <Label Text="G" 
                           TextColor="#0284C7" 
                           FontAttributes="Bold" 
                           FontSize="14" />
                    <Label Text="Google" 
                           TextColor="#44403C" 
                           FontAttributes="Bold" 
                           FontSize="12" />
                </HorizontalStackLayout>
            </Border>

            <!-- Some law here -->
            <Label Text="Compliant with Malaysian PDPA 2010." 
                   FontSize="10" 
                   TextColor="#78716C" 
                   HorizontalOptions="Center" 
                   Margin="0, 10, 0, 10" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>