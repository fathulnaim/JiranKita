<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:JiranKita.Controls"
             x:Class="JiranKita.Views.login"
             BackgroundColor="#FAFAF9"
             Shell.NavBarIsVisible="False">

    <!-- Main scrollable container preventing soft keyboard overlap on smaller screens -->
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- ================= 1. TOP HEADER BAR ================= -->
            <Grid ColumnDefinitions="Auto, *" Margin="0,10,0,5">

                <!-- Reusable back navigation button -->
                <controls:BackButton Grid.Column="0" />

                <!-- Right-aligned static Language Selection Pill ("EN") -->
                <HorizontalStackLayout Grid.Column="1" 
                                       HorizontalOptions="End" 
                                       VerticalOptions="Center" 
                                       Spacing="6">
                    <Label Text="Language:" 
                           FontSize="12" 
                           TextColor="#78716C" 
                           VerticalOptions="Center" />
                    <Border StrokeShape="RoundRectangle 6" 
                            Stroke="#E7E5E4" 
                            BackgroundColor="White" 
                            Padding="8, 2">
                        <Label Text="EN" 
                               FontSize="11" 
                               FontAttributes="Bold" 
                               TextColor="#065F46" />
                    </Border>
                </HorizontalStackLayout>
            </Grid>

            <!-- ================= 2. WELCOME GREETING BANNER ================= -->
            <VerticalStackLayout Spacing="4" Margin="0, 5, 0, 5">
                <Label Text="Welcome Neighbour!" 
                       FontSize="20" 
                       FontAttributes="Bold" 
                       TextColor="#1C1917" />
                <Label Text="Sign in to your registered residency precinct" 
                       FontSize="12" 
                       TextColor="#78716C" />
            </VerticalStackLayout>

            <!-- ================= 3. AUTHENTICATION INPUT FIELDS ================= -->

            <!-- Email Entry Field -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Residential / User Email" 
                       FontSize="12" 
                       TextColor="#44403C" 
                       FontAttributes="Bold" />
                <Border StrokeShape="RoundRectangle 12" 
                        Stroke="#D6D3D1" 
                        BackgroundColor="White" 
                        Padding="12, 2">
                    <Entry x:Name="TxtEmail"
                           Placeholder="Enter residential / user email"
                           PlaceholderColor="#A8A29E"
                           Keyboard="Email"
                           FontSize="13"
                           TextColor="#1C1917" />
                </Border>
            </VerticalStackLayout>

            <!-- Password Entry Field with Show/Hide Eye Toggle -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Password" 
                       FontSize="12" 
                       TextColor="#44403C" 
                       FontAttributes="Bold" />
                <Border StrokeShape="RoundRectangle 12" 
                        Stroke="#D6D3D1" 
                        BackgroundColor="White" 
                        Padding="12, 2">
                    <Grid ColumnDefinitions="*, Auto">
                        <Entry x:Name="TxtPassword"
                               Grid.Column="0" 
                               Placeholder="Enter password"
                               PlaceholderColor="#A8A29E"
                               IsPassword="True" 
                               FontSize="13" 
                               TextColor="#1C1917" />

                        <!-- Interactive Eye Icon to toggle IsPassword true/false in code-behind -->
                        <Label x:Name="LblTogglePassword"
                               Grid.Column="1" 
                               Text="👁" 
                               FontSize="14" 
                               VerticalOptions="Center" 
                               TextColor="#A8A29E" 
                               Margin="0,0,5,0">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTogglePasswordTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- ================= 4. REMEMBER ME & FORGOT PASSWORD ROW ================= -->
            <Grid ColumnDefinitions="*, Auto">
                <!-- Remember Me Checkbox + Tappable Label (saves credentials locally via Preferences) -->
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center" Margin="0, -2, 0, 2">
                    <CheckBox x:Name="ChkRememberMe" IsChecked="False" Color="#047857" VerticalOptions="Center" />
                    <Label Text="Remember my login details" FontSize="12" TextColor="#44403C" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRememberMeLabelTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

                <!-- Forgot Password Navigation Link -->
                <Label Grid.Column="1" 
                       Text="Forgot?" 
                       TextColor="#065F46" 
                       FontAttributes="Bold" 
                       FontSize="12" 
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnForgotPasswordClicked" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <!-- ================= 5. SIGN IN BUTTON & FOOTER LINKS ================= -->

            <!-- Primary Sign In Action Button (triggers Firebase user lookup & verification check) -->
            <Button Text="SIGN IN TO JIRANKITA" 
                    BackgroundColor="#047857" 
                    TextColor="White" 
                    FontAttributes="Bold" 
                    FontSize="12" 
                    CornerRadius="12" 
                    HeightRequest="48" 
                    Margin="0, 8, 0, 0" 
                    Clicked="OnContinueClicked" />

            <!-- Resident Registration Navigation Link -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="4" Margin="0, 8, 0, 0">
                <Label Text="Don't have a registered unit?" FontSize="12" TextColor="#78716C" VerticalOptions="Center" />
                <Label Text="Register Resident" 
                       FontSize="12" 
                       FontAttributes="Bold" 
                       TextColor="#047857" 
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSignUpLinkClicked" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

            <!-- Malaysian PDPA 2010 Data Privacy Notice -->
            <Label Text="Compliant with Malaysian PDPA 2010." 
                   FontSize="10" 
                   TextColor="#78716C" 
                   HorizontalOptions="Center" 
                   Margin="0, 10, 0, 10" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>