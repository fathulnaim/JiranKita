<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:JiranKita.Models"
             x:Class="JiranKita.Views.ChatInboxPage"
             BackgroundColor="#FAFAF9"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="True">

    <Grid RowDefinitions="Auto, *">

        <!-- ================= 1. HEADER BAR ================= -->
        <Border Grid.Row="0" Stroke="#E7E5E4" StrokeThickness="1" BackgroundColor="White" Padding="16, 12">
            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                    <Label Text="NEIGHBOURHOOD CHATS" FontSize="12" FontAttributes="Bold" TextColor="#1C1917" CharacterSpacing="1" />
                    <Label x:Name="LblCommunitySub" Text="Loading..." FontSize="10" TextColor="#78716C" />
                </VerticalStackLayout>

                <!-- JiranBot AI Assistant Shortcut Button -->
                <Border Grid.Column="1" StrokeShape="RoundRectangle 10" BackgroundColor="#F3E8FF" Stroke="#E9D5FF" HeightRequest="36" WidthRequest="36">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRobotClicked" />
                    </Border.GestureRecognizers>
                    <Label Text="🤖" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- ================= 2. CONVERSATION LIST CONTENT ================= -->
        <ScrollView Grid.Row="1" Padding="14">
            <VerticalStackLayout Spacing="14">

                <!-- A. OFFICIAL COMMUNITY GROUP CHAT (PINNED ON TOP) -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="COMMUNITY GROUP" FontSize="10" FontAttributes="Bold" TextColor="#78716C" CharacterSpacing="1" />

                    <Border StrokeShape="RoundRectangle 16" Stroke="#A7F3D0" BackgroundColor="#ECFDF5" Padding="12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOpenGroupChatClicked" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                            <Border Grid.Column="0" StrokeShape="RoundRectangle 14" BackgroundColor="#047857" HeightRequest="44" WidthRequest="44">
                                <Label Text="🏢" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label x:Name="LblGroupName" Text="Community Group Chat" FontSize="13" FontAttributes="Bold" TextColor="#1C1917" />
                                <Label Text="Tap to join neighbourhood conversation..." FontSize="11" TextColor="#57534E" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>

                            <Border Grid.Column="2" StrokeShape="RoundRectangle 8" BackgroundColor="#047857" Padding="6, 2" VerticalOptions="Center">
                                <Label Text="LIVE" FontSize="9" FontAttributes="Bold" TextColor="White" />
                            </Border>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- B. DYNAMIC DIRECT MESSAGES LIST (FROM DATABASE) -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="DIRECT MESSAGES (1-ON-1)" FontSize="10" FontAttributes="Bold" TextColor="#78716C" CharacterSpacing="1" />

                    <CollectionView x:Name="CvDirectChats" SelectionMode="Single" SelectionChanged="OnDirectChatSelected">

                        <!-- Empty View State (When no 1-on-1 conversations exist) -->
                        <CollectionView.EmptyView>
                            <Border StrokeShape="RoundRectangle 14" Stroke="#E7E5E4" BackgroundColor="White" Padding="18">
                                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                    <Label Text="💬" FontSize="26" HorizontalOptions="Center" />
                                    <Label Text="No private conversations yet." FontSize="11" FontAttributes="Bold" TextColor="#1C1917" HorizontalOptions="Center" />
                                    <Label Text="Tap 'Contact Author' on a neighbour's post to start chatting!" FontSize="10" TextColor="#78716C" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:DirectConversationModel">
                                <Border StrokeShape="RoundRectangle 14" Stroke="#E7E5E4" BackgroundColor="White" Padding="12" Margin="0, 0, 0, 8">
                                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                                        <Border Grid.Column="0" StrokeShape="RoundRectangle 12" BackgroundColor="#065F46" HeightRequest="40" WidthRequest="40">
                                            <Label Text="{Binding Initials}" TextColor="White" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding DisplayTitle}" FontSize="12" FontAttributes="Bold" TextColor="#1C1917" />
                                            <Label Text="{Binding LastMessage}" FontSize="11" TextColor="#78716C" MaxLines="1" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>

                                        <Label Grid.Column="2" Text="➔" FontSize="12" TextColor="#A8A29E" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>