<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:JiranKita.Controls"
             x:Class="JiranKita.Views.ForgotPasswordPage"
             BackgroundColor="#FAFAF9"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <ScrollView x:Name="ResetScrollView" Orientation="Vertical">
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Top Bar -->
            <Grid ColumnDefinitions="Auto, *" Margin="0, 5, 0, 0">
                <controls:BackButton Grid.Column="0" />
                <Border Grid.Column="1"
                        HorizontalOptions="End"
                        VerticalOptions="Center"
                        StrokeShape="RoundRectangle 20"
                        Stroke="#FDE68A"
                        BackgroundColor="#FFFBEB"
                        Padding="12, 5">
                    <Label Text="Account Recovery" FontSize="11" FontAttributes="Bold" TextColor="#78350F" />
                </Border>
            </Grid>

            <!-- Ikon & Tajuk -->
            <VerticalStackLayout Spacing="8" Margin="0, 10, 0, 0">
                <Border StrokeShape="RoundRectangle 20"
                        BackgroundColor="#ECFDF5"
                        Stroke="#A7F3D0"
                        HeightRequest="60"
                        WidthRequest="60"
                        HorizontalOptions="Start">
                    <Label Text="🔐" FontSize="26" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <Label Text="Reset Password" FontSize="22" FontAttributes="Bold" TextColor="#1C1917" />
                <Label Text="Masukkan emel atau nombor telefon berdaftar anda untuk menerima kod pengesahan penetapan semula kata laluan." 
                       FontSize="11" 
                       TextColor="#78716C" 
                       LineHeight="1.3" />
            </VerticalStackLayout>

            <!-- Kad Borang -->
            <Border StrokeShape="RoundRectangle 16"
                    Stroke="#E7E5E4"
                    BackgroundColor="White"
                    Padding="16"
                    Margin="0, 6, 0, 10">

                <VerticalStackLayout Spacing="14">

                    <!-- Emel / Phone [DB: users.email / phone] -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Residential Email / Phone *" FontSize="12" FontAttributes="Bold" TextColor="#44403C" />
                        <Border StrokeShape="RoundRectangle 12" Stroke="#D6D3D1" BackgroundColor="#FAFAF9" Padding="12, 2">
                            <Entry x:Name="TxtRecoveryInput" 
                                   Placeholder="Contoh: naim@uniten.edu.my" 
                                   PlaceholderColor="#A8A29E" 
                                   FontSize="13" 
                                   TextColor="#1C1917"
                                   Focused="OnInputFocused" 
                                   Unfocused="OnInputUnfocused" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Butang Hantar OTP -->
                    <Button Text="SEND VERIFICATION CODE ➔" 
                            Clicked="OnSendOtpClicked"
                            BackgroundColor="#047857" 
                            TextColor="White" 
                            FontAttributes="Bold" 
                            FontSize="12" 
                            CornerRadius="12" 
                            HeightRequest="48" />

                    <!-- BAHAGIAN MASUKKAN KOD & KATA LALUAN BARU (Mula-mula disorok, muncul lepas tekan hantar OTP) -->
                    <VerticalStackLayout x:Name="ResetSection" Spacing="14" IsVisible="False">
                        <BoxView HeightRequest="1" Color="#F5F5F4" Margin="0, 4" />

                        <!-- 6-Digit OTP [DB: password_resets.token] -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="6-Digit Verification Code *" FontSize="12" FontAttributes="Bold" TextColor="#44403C" />
                            <Border StrokeShape="RoundRectangle 12" Stroke="#D6D3D1" BackgroundColor="#FAFAF9" Padding="12, 2">
                                <Entry x:Name="TxtOtpCode" Placeholder="123456" PlaceholderColor="#A8A29E" MaxLength="6" FontSize="14" FontAttributes="Bold" TextColor="#065F46" Keyboard="Numeric"
                                       Focused="OnInputFocused" Unfocused="OnInputUnfocused" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Kata Laluan Baharu [DB: users.password_hash] -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="New Password *" FontSize="12" FontAttributes="Bold" TextColor="#44403C" />
                            <Border StrokeShape="RoundRectangle 12" Stroke="#D6D3D1" BackgroundColor="#FAFAF9" Padding="12, 2">
                                <Entry x:Name="TxtNewPassword" Placeholder="Minimum 8 aksara" PlaceholderColor="#A8A29E" IsPassword="True" FontSize="13" TextColor="#1C1917"
                                       Focused="OnInputFocused" Unfocused="OnInputUnfocused" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Sahkan Kata Laluan Baharu -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Confirm New Password *" FontSize="12" FontAttributes="Bold" TextColor="#44403C" />
                            <Border StrokeShape="RoundRectangle 12" Stroke="#D6D3D1" BackgroundColor="#FAFAF9" Padding="12, 2">
                                <Entry x:Name="TxtConfirmPassword" Placeholder="Ulang kata laluan baharu" PlaceholderColor="#A8A29E" IsPassword="True" FontSize="13" TextColor="#1C1917"
                                       Focused="OnInputFocused" Unfocused="OnInputUnfocused" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Butang Kemas Kini -->
                        <Button Text="UPDATE PASSWORD &amp; SIGN IN" 
                                Clicked="OnUpdatePasswordClicked"
                                BackgroundColor="#047857" 
                                TextColor="White" 
                                FontAttributes="Bold" 
                                FontSize="12" 
                                CornerRadius="12" 
                                HeightRequest="48" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>