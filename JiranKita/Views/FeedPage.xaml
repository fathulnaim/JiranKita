<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:JiranKita.Models"
             x:Class="JiranKita.Views.FeedPage"
             BackgroundColor="#FAFAF9"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="True">

    <Grid RowDefinitions="Auto, Auto, *">

        <!-- ================= 1. SEARCH BAR ================= -->
        <Border Grid.Row="0" Stroke="#E7E5E4" StrokeThickness="1" BackgroundColor="White" Padding="14, 10">
            <Border StrokeShape="RoundRectangle 12" Stroke="#E7E5E4" BackgroundColor="#FAFAF9" Padding="10, 0">
                <Grid ColumnDefinitions="Auto, *">
                    <Label Grid.Column="0" Text="🔍" FontSize="13" TextColor="#A8A29E" VerticalOptions="Center" VerticalTextAlignment="Center" Margin="0, 0, 6, 0" />
                    <Entry x:Name="TxtSearch" 
                           Placeholder="Search feed, tags, items..." 
                           PlaceholderColor="#A8A29E" 
                           FontSize="12" 
                           TextColor="#1C1917"
                           TextChanged="OnSearchTextChanged" />
                </Grid>
            </Border>
        </Border>

        <!-- ================= 2. CATEGORY FILTERS ================= -->
        <Border Grid.Row="1" Stroke="#E7E5E4" StrokeThickness="1" BackgroundColor="#F5F5F4" Padding="12, 8">
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="8">
                    <Button x:Name="PillAll" Text="All" Clicked="OnFilterPillClicked" BackgroundColor="#047857" TextColor="White" FontAttributes="Bold" FontSize="11" CornerRadius="8" HeightRequest="32" Padding="12, 0" />
                    <Button x:Name="PillLost" Text="Lost &amp; Found" Clicked="OnFilterPillClicked" BackgroundColor="White" TextColor="#44403C" BorderColor="#D6D3D1" BorderWidth="1" FontSize="11" CornerRadius="8" HeightRequest="32" Padding="12, 0" />
                    <Button x:Name="PillRoad" Text="Road &amp; Maint" Clicked="OnFilterPillClicked" BackgroundColor="White" TextColor="#44403C" BorderColor="#D6D3D1" BorderWidth="1" FontSize="11" CornerRadius="8" HeightRequest="32" Padding="12, 0" />
                    <Button x:Name="PillEvents" Text="Events" Clicked="OnFilterPillClicked" BackgroundColor="White" TextColor="#44403C" BorderColor="#D6D3D1" BorderWidth="1" FontSize="11" CornerRadius="8" HeightRequest="32" Padding="12, 0" />
                    <Button x:Name="PillOfficial" Text="Official" Clicked="OnFilterPillClicked" BackgroundColor="White" TextColor="#44403C" BorderColor="#D6D3D1" BorderWidth="1" FontSize="11" CornerRadius="8" HeightRequest="32" Padding="12, 0" />
                </HorizontalStackLayout>
            </ScrollView>
        </Border>

        <!-- ================= 3. FIREBASE FEED POSTS ================= -->
        <Grid Grid.Row="2">
            <VerticalStackLayout Padding="14, 8, 14, 0" Spacing="6">
                <!-- Dynamic Count Summary -->
                <Label x:Name="LblFeedSummary" Text="Loading community feed..." FontSize="11" TextColor="#78716C" Margin="2, 0" />

                <CollectionView x:Name="FeedCollectionView"
                                SelectionMode="Single"
                                SelectionChanged="OnPostSelected"
                                Margin="0, 4, 0, 0">

                    <CollectionView.EmptyView>
                        <Border StrokeShape="RoundRectangle 16" Stroke="#E7E5E4" BackgroundColor="White" Padding="24" Margin="0, 20">
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Label Text="📭" FontSize="36" HorizontalOptions="Center" />
                                <Label Text="No posts found." FontSize="13" FontAttributes="Bold" TextColor="#1C1917" HorizontalOptions="Center" />
                                <Label Text="Tap the + CREATE button below to make a new post!" FontSize="11" TextColor="#78716C" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:PostModel">
                            <Border StrokeShape="RoundRectangle 16" 
                                    Stroke="#E7E5E4" 
                                    BackgroundColor="White" 
                                    Padding="14" 
                                    Margin="0, 0, 0, 12">
                                <VerticalStackLayout Spacing="8">

                                    <Grid ColumnDefinitions="Auto, *">
                                        <Border Grid.Column="0" StrokeShape="RoundRectangle 4" BackgroundColor="#FEF3C7" Stroke="#FDE68A" Padding="6, 2">
                                            <Label Text="{Binding Category}" FontSize="9" FontAttributes="Bold" TextColor="#92400E" />
                                        </Border>
                                        <Label Grid.Column="1" Text="{Binding TimeAgoDisplay}" FontSize="10" TextColor="#78716C" HorizontalOptions="End" VerticalOptions="Center" />
                                    </Grid>

                                    <Label Text="{Binding Title}" FontSize="13" FontAttributes="Bold" TextColor="#1C1917" LineHeight="1.2" />
                                    <Label Text="{Binding Description}" FontSize="11" TextColor="#57534E" LineHeight="1.2" MaxLines="2" LineBreakMode="TailTruncation" />

                                    <!-- Post Image (Rendered only if present) -->
                                    <Border StrokeShape="RoundRectangle 12" BackgroundColor="#F5F5F4" Stroke="#E7E5E4" HeightRequest="120" IsVisible="{Binding HasImage}" Padding="0">
                                        <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                                    </Border>

                                    <Grid ColumnDefinitions="*, Auto" Margin="0, 2">
                                        <Border Grid.Column="0" StrokeShape="RoundRectangle 6" BackgroundColor="#F5F5F4" Stroke="#E7E5E4" Padding="8, 3" HorizontalOptions="Start">
                                            <Label Text="{Binding Location, StringFormat='📍 {0}'}" FontSize="10" TextColor="#44403C" />
                                        </Border>
                                        <Label Grid.Column="1" Text="{Binding AuthorName, StringFormat='By: {0}'}" FontSize="10" TextColor="#78716C" VerticalOptions="Center" />
                                    </Grid>

                                    <BoxView HeightRequest="1" Color="#F5F5F4" Margin="0, 2" />

                                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center" Margin="0, 2, 0, 0">
                                        <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                            <Label Text="💬" FontSize="12" VerticalOptions="Center" />
                                            <Label Text="{Binding DisplayCommentsCount, StringFormat='{0} comments'}" FontSize="11" TextColor="#78716C" VerticalOptions="Center" />
                                        </HorizontalStackLayout>

                                        <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                            <Label Text="View Details" FontSize="11" FontAttributes="Bold" TextColor="#047857" VerticalOptions="Center" />
                                            <Label Text="➔" FontSize="11" TextColor="#047857" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Grid>

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- Floating Action Button (+ CREATE) -->
            <Border StrokeShape="RoundRectangle 24"
                    BackgroundColor="#047857"
                    Stroke="Transparent"
                    Padding="16, 10"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    Margin="0, 0, 16, 20"
                    Shadow="{Shadow Brush=Black, Offset='0,4', Radius=10, Opacity=0.25}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCreatePostClicked" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Label Text="+" TextColor="White" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                    <Label Text="CREATE" TextColor="White" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>