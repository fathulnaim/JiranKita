<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:JiranKita.Views"
             x:Class="JiranKita.Views.ProfilePage"
             x:DataType="views:ProfilePage"
             BackgroundColor="#FAFAF9"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="True">

    <Grid RowDefinitions="Auto, *">

        <!-- ================= 1. TOP HEADER BAR ================= -->
        <Border Grid.Row="0" Stroke="#E7E5E4" StrokeThickness="1" BackgroundColor="White" Padding="16, 12">
            <Grid ColumnDefinitions="*, Auto">
                <Label Grid.Column="0" Text="PROFILE" FontSize="12" FontAttributes="Bold" TextColor="#1C1917" CharacterSpacing="1" VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- ================= 2. PROFILE CONTENT (SCROLLABLE) ================= -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- DYNAMIC PROFILE CARD [AppSession] -->
                <Border StrokeShape="RoundRectangle 16" Stroke="#E7E5E4" BackgroundColor="White" Padding="14">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                        <!-- Dynamic Avatar Initials -->
                        <Border Grid.Column="0" StrokeShape="RoundRectangle 14" BackgroundColor="#065F46" HeightRequest="48" WidthRequest="48">
                            <Label Text="{Binding UserInitials}" TextColor="White" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <!-- Actual Full Name -->
                            <Label Text="{Binding FullNameDisplay}" FontSize="13" FontAttributes="Bold" TextColor="#1C1917" />

                            <!-- Actual Unit & Community -->
                            <Label Text="{Binding UnitCommunityDisplay}" FontSize="10" TextColor="#78716C" />

                            <HorizontalStackLayout Spacing="6" Margin="0, 3, 0, 0">
                                <!-- Role / Status Badge -->
                                <Border StrokeShape="RoundRectangle 4"
                                    BackgroundColor="{Binding RoleBadgeBgColor}"
                                    Stroke="{Binding RoleBadgeBorderColor}"
                                    Padding="6, 2">
                                    <Label Text="{Binding RoleBadgeDisplay}"
                                       FontSize="9"
                                       FontAttributes="Bold"
                                       TextColor="{Binding RoleBadgeTextColor}" />
                                </Border>

                                <!-- Actual Masked IC Number -->
                                <Label Text="{Binding MaskedIcDisplay}" FontSize="9" TextColor="#78716C" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- JMB ADMIN TOOLS SECTION (ONLY VISIBLE IF USER == ADMIN!) -->
                <VerticalStackLayout Spacing="6" IsVisible="{Binding IsAdmin}">
                    <Label Text="JMB COMMITTEE TOOLS (Admin)" FontSize="10" FontAttributes="Bold" TextColor="#581C87" CharacterSpacing="1" />

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                        <!-- Button 1: Issue Notice -->
                        <Border Grid.Column="0" StrokeShape="RoundRectangle 12" Stroke="#E9D5FF" BackgroundColor="White" Padding="10, 12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnIssueNoticeClicked" />
                            </Border.GestureRecognizers>
                            <Label Text="📢 Issue Official Notice" FontSize="10" FontAttributes="Bold" TextColor="#3B0764" LineHeight="1.2" />
                        </Border>

                        <!-- Button 2: Approvals Queue -->
                        <Border Grid.Column="1" StrokeShape="RoundRectangle 12" Stroke="#E9D5FF" BackgroundColor="White" Padding="10, 12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnApprovalsQueueClicked" />
                            </Border.GestureRecognizers>
                            <Label Text="👥 Approvals Queue" FontSize="10" FontAttributes="Bold" TextColor="#3B0764" LineHeight="1.2" />
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <!-- DYNAMIC RESIDENCY MANAGEMENT SECTION -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="RESIDENCY MANAGEMENT" FontSize="10" FontAttributes="Bold" TextColor="#78716C" CharacterSpacing="1" />

                    <Border StrokeShape="RoundRectangle 16" Stroke="#E7E5E4" BackgroundColor="White" Padding="0">
                        <VerticalStackLayout Spacing="0">
                            <!-- Registered Unit Number -->
                            <Grid ColumnDefinitions="*, Auto" Padding="14, 12">
                                <Label Grid.Column="0" Text="{Binding UnitSummaryDisplay}" FontSize="11" TextColor="#292524" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="➔" FontSize="11" TextColor="#A8A29E" VerticalOptions="Center" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="#F5F5F4" />

                            <!-- Registered Household Members Count -->
                            <Grid ColumnDefinitions="*, Auto" Padding="14, 12">
                                <Label Grid.Column="0" Text="{Binding OccupantsSummaryDisplay}" FontSize="11" TextColor="#292524" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="➔" FontSize="11" TextColor="#A8A29E" VerticalOptions="Center" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="#F5F5F4" />

                            <!-- Current Active Community -->
                            <Grid ColumnDefinitions="*, Auto" Padding="14, 12">
                                <Label Grid.Column="0" Text="{Binding CommunitySummaryDisplay}" FontSize="11" TextColor="#292524" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="➔" FontSize="11" TextColor="#A8A29E" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ABOUT COURSEWORK BUTTON -->
                <Border StrokeShape="RoundRectangle 14" Stroke="#E7E5E4" BackgroundColor="White" Padding="14, 12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAboutClicked" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="ℹ️ About JiranKita (MAD6102)" FontSize="11" FontAttributes="Bold" TextColor="#292524" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="➔" FontSize="11" TextColor="#047857" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- LOGOUT BUTTON -->
                <Button Text="🚪 LOG OUT OF ACCOUNT" 
                        Clicked="OnLogoutClicked"
                        BackgroundColor="#FFF1F2" 
                        TextColor="#9F1239" 
                        BorderColor="#FECDD3" 
                        BorderWidth="1" 
                        FontAttributes="Bold" 
                        FontSize="11" 
                        CornerRadius="12" 
                        HeightRequest="44" 
                        Margin="0, 4, 0, 10" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>