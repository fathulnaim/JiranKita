<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:JiranKita.Models"
             xmlns:views="clr-namespace:JiranKita.Views"
             x:Class="JiranKita.Views.HomePage"
             x:DataType="views:HomePage"
             BackgroundColor="#FAFAF9"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="True">

    <Grid RowDefinitions="Auto, *">

        <!-- ================= 1. HEADER ATAS (DINAMIK DARI SESI) ================= -->
        <Border Grid.Row="0" Stroke="#E7E5E4" StrokeThickness="1" BackgroundColor="White" Padding="16, 12">
            <Grid ColumnDefinitions="*, Auto">

                <!-- Info Komuniti [AppSession] -->
                <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                    <Label Text="📍" FontSize="16" VerticalOptions="Center" />
                    <VerticalStackLayout Spacing="0">
                        <Label Text="{Binding CommunityNameDisplay}" 
                               FontSize="13" 
                               FontAttributes="Bold" 
                               TextColor="#1C1917" />
                        <Label Text="{Binding UnitDisplay}" 
                               FontSize="10" 
                               TextColor="#78716C" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <!-- Loceng & Avatar [AppSession] -->
                <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                    <!-- Loceng Notifikasi -->
                    <Border StrokeShape="RoundRectangle 10" Stroke="#E7E5E4" BackgroundColor="#F5F5F4" HeightRequest="36" WidthRequest="36">
                        <Label Text="🔔" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <!-- Avatar Initials Pengguna -->
                    <Border StrokeShape="RoundRectangle 18" BackgroundColor="#065F46" Stroke="Transparent" HeightRequest="34" WidthRequest="34">
                        <Label Text="{Binding UserInitialsDisplay}" 
                               TextColor="White" 
                               FontSize="11" 
                               FontAttributes="Bold" 
                               HorizontalOptions="Center" 
                               VerticalOptions="Center" />
                    </Border>
                </HorizontalStackLayout>

            </Grid>
        </Border>


        <!-- ================= 2. KANDUNGAN UTAMA (SCROLLABLE) ================= -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- A. KAD AMARAN KECEMASAN (HANYA MUNCUL JIKA ADA AMARAN DI FIREBASE) -->
                <Border StrokeShape="RoundRectangle 16"
                        Stroke="#FDE68A"
                        BackgroundColor="#FFFBEB"
                        Padding="14"
                        IsVisible="{Binding HasUrgentAlert}">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                        <Border Grid.Column="0" StrokeShape="RoundRectangle 8" BackgroundColor="#FEF3C7" Stroke="Transparent" HeightRequest="36" WidthRequest="36" VerticalOptions="Start">
                            <Label Text="⚠️" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" Text="{Binding ActiveAlert.Title}" FontSize="10" FontAttributes="Bold" TextColor="#78350F" />
                                <Label Grid.Column="1" Text="{Binding ActiveAlert.TimeDisplay}" FontSize="10" TextColor="#92400E" FontAttributes="Bold" />
                            </Grid>

                            <Label Text="{Binding ActiveAlert.Description}" FontSize="11" TextColor="#44403C" LineHeight="1.2" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>


                <!-- B. QUICK ACTIONS (BUTANG TINDAKAN PANTAS) -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="QUICK ACTIONS" FontSize="11" FontAttributes="Bold" TextColor="#1C1917" CharacterSpacing="1" />

                    <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="8">
                        <!-- 1. Report (Buka Create Post) -->
                        <Border Grid.Column="0" StrokeShape="RoundRectangle 14" Stroke="#E7E5E4" BackgroundColor="White" Padding="8, 12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnReportActionClicked" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Label Text="🔧" FontSize="18" HorizontalOptions="Center" />
                                <Label Text="Report" FontSize="11" FontAttributes="Bold" TextColor="#292524" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- 2. Notices -->
                        <Border Grid.Column="1" StrokeShape="RoundRectangle 14" Stroke="#E7E5E4" BackgroundColor="White" Padding="8, 12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnNoticesActionClicked" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Label Text="📋" FontSize="18" HorizontalOptions="Center" />
                                <Label Text="Notices" FontSize="11" FontAttributes="Bold" TextColor="#292524" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- 3. Events -->
                        <Border Grid.Column="2" StrokeShape="RoundRectangle 14" Stroke="#E7E5E4" BackgroundColor="White" Padding="8, 12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEventsActionClicked" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Label Text="📅" FontSize="18" HorizontalOptions="Center" />
                                <Label Text="Events" FontSize="11" FontAttributes="Bold" TextColor="#292524" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- 4. JiranBot (Buka AI Chat) -->
                        <Border Grid.Column="3" StrokeShape="RoundRectangle 14" Stroke="#E7E5E4" BackgroundColor="White" Padding="8, 12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnJiranBotActionClicked" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Label Text="🤖" FontSize="18" HorizontalOptions="Center" />
                                <Label Text="JiranBot" FontSize="11" FontAttributes="Bold" TextColor="#292524" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>


                <!-- C. NEIGHBOURHOOD PULSE FEED (2 POS TERKINI DARI FIREBASE) -->
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <BoxView Color="#059669" CornerRadius="4" WidthRequest="8" HeightRequest="8" VerticalOptions="Center" />
                        <Label Text="NEIGHBOURHOOD PULSE" FontSize="11" FontAttributes="Bold" TextColor="#1C1917" CharacterSpacing="1" />
                    </HorizontalStackLayout>

                    <!-- Senarai Pos Terkini Dinamik -->
                    <CollectionView x:Name="PulseCollectionView"
                                    SelectionMode="Single"
                                    SelectionChanged="OnPulsePostSelected">

                        <CollectionView.EmptyView>
                            <Border StrokeShape="RoundRectangle 12" Stroke="#E7E5E4" BackgroundColor="White" Padding="16">
                                <Label Text="Tiada kemas kini komuniti buat masa ini." FontSize="11" TextColor="#78716C" HorizontalTextAlignment="Center" />
                            </Border>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:PostModel">
                                <Border StrokeShape="RoundRectangle 16" Stroke="#E7E5E4" BackgroundColor="White" Padding="14" Margin="0, 0, 0, 10">
                                    <VerticalStackLayout Spacing="6">
                                        <Grid ColumnDefinitions="Auto, *">
                                            <Border Grid.Column="0" StrokeShape="RoundRectangle 4" BackgroundColor="#FEF3C7" Stroke="#FDE68A" Padding="6, 2">
                                                <Label Text="{Binding Category}" FontSize="9" FontAttributes="Bold" TextColor="#92400E" />
                                            </Border>
                                            <Label Grid.Column="1" Text="{Binding TimeAgoDisplay}" FontSize="10" TextColor="#78716C" HorizontalOptions="End" VerticalOptions="Center" />
                                        </Grid>

                                        <Label Text="{Binding Title}" FontSize="12" FontAttributes="Bold" TextColor="#1C1917" LineHeight="1.2" />
                                        <Label Text="{Binding Description}" FontSize="11" TextColor="#57534E" LineHeight="1.2" MaxLines="2" LineBreakMode="TailTruncation" />

                                        <BoxView HeightRequest="1" Color="#F5F5F4" Margin="0, 2" />

                                        <Grid ColumnDefinitions="*, Auto">
                                            <Label Grid.Column="0" Text="{Binding AuthorName, StringFormat='By: {0}'}" FontSize="10" TextColor="#78716C" />
                                            <Label Grid.Column="1" Text="{Binding DisplayCommentsCount, StringFormat='💬 {0} comments'}" FontSize="10" FontAttributes="Bold" TextColor="#047857" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>