<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:JiranKita.Models"
             xmlns:views="clr-namespace:JiranKita.Views"
             x:Class="JiranKita.Views.AlertsPage"
             x:DataType="views:AlertsPage"
             BackgroundColor="#FAFAF9"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="True">

    <Grid RowDefinitions="Auto, Auto, Auto, *">

        <!-- ================= 1. HEADER (ACTUAL LOCATION) ================= -->
        <Border Grid.Row="0" Stroke="#E7E5E4" StrokeThickness="1" BackgroundColor="White" Padding="16, 12">
            <Grid ColumnDefinitions="*, Auto">
                <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                    <Label Text="📍" FontSize="16" TextColor="#047857" VerticalOptions="Center" />
                    <!-- Dynamic Community Title -->
                    <Label Text="{Binding CommunityTitleDisplay}" FontSize="13" FontAttributes="Bold" TextColor="#1C1917" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <!-- Map Re-center Button -->
                <Border Grid.Column="1" StrokeShape="RoundRectangle 8" BackgroundColor="#F5F5F4" Stroke="#E7E5E4" HeightRequest="32" WidthRequest="32">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRecenterMapClicked" />
                    </Border.GestureRecognizers>
                    <Label Text="🎯" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- ================= 2. CATEGORY FILTERS ================= -->
        <Border Grid.Row="1" Stroke="#E7E5E4" StrokeThickness="1" BackgroundColor="#F5F5F4" Padding="12, 8">
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="8">
                    <Button x:Name="PillAll" Text="All" Clicked="OnFilterAlertClicked" BackgroundColor="#047857" TextColor="White" FontAttributes="Bold" FontSize="10" CornerRadius="8" HeightRequest="30" Padding="12, 0" />
                    <Button x:Name="PillRoad" Text="🚧 Road" Clicked="OnFilterAlertClicked" BackgroundColor="White" TextColor="#78350F" BorderColor="#D6D3D1" BorderWidth="1" FontSize="10" CornerRadius="8" HeightRequest="30" Padding="10, 0" />
                    <Button x:Name="PillHazards" Text="⚠️ Hazards" Clicked="OnFilterAlertClicked" BackgroundColor="White" TextColor="#9F1239" BorderColor="#D6D3D1" BorderWidth="1" FontSize="10" CornerRadius="8" HeightRequest="30" Padding="10, 0" />
                    <Button x:Name="PillSecurity" Text="🚨 Security" Clicked="OnFilterAlertClicked" BackgroundColor="White" TextColor="#0369A1" BorderColor="#D6D3D1" BorderWidth="1" FontSize="10" CornerRadius="8" HeightRequest="30" Padding="10, 0" />
                </HorizontalStackLayout>
            </ScrollView>
        </Border>

        <!-- ================= 3. INTERACTIVE MAP (OPENSTREETMAP) ================= -->
        <Grid Grid.Row="2" HeightRequest="190">
            <!-- WebView loading real GPS map -->
            <WebView x:Name="MapWebView" />

            <!-- Geofence Badge at Map Bottom Corner -->
            <Border StrokeShape="RoundRectangle 6" 
                    BackgroundColor="#F2FFFFFF" 
                    Stroke="#D6D3D1" 
                    Padding="6, 2" 
                    HorizontalOptions="End" 
                    VerticalOptions="End" 
                    Margin="8">
                <Label Text="Radius: 500m geofence active" FontSize="9" FontAttributes="Bold" TextColor="#047857" />
            </Border>
        </Grid>

        <!-- ================= 4. ALERTS LIST FROM DATABASE & SOS BUTTON ================= -->
        <Grid Grid.Row="3">
            <ScrollView Padding="16">
                <VerticalStackLayout Spacing="14">

                    <!-- Dynamic Alerts List -->
                    <CollectionView x:Name="AlertsCollectionView" SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Border StrokeShape="RoundRectangle 12" Stroke="#E7E5E4" BackgroundColor="White" Padding="18">
                                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                    <Label Text="✅" FontSize="26" HorizontalOptions="Center" />
                                    <Label Text="No active hazard alerts in your area." FontSize="11" FontAttributes="Bold" TextColor="#047857" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:AlertModel">
                                <Border StrokeShape="RoundRectangle 16" Stroke="#FECDD3" BackgroundColor="#FFF1F2" Padding="14" Margin="0, 0, 0, 10">
                                    <VerticalStackLayout Spacing="5">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <Border Grid.Column="0" StrokeShape="RoundRectangle 4" BackgroundColor="#E11D48" Stroke="Transparent" Padding="6, 2" HorizontalOptions="Start">
                                                <Label Text="{Binding Title, StringFormat='HIGH ALERT: {0}'}" FontSize="9" FontAttributes="Bold" TextColor="White" />
                                            </Border>
                                            <Label Grid.Column="1" Text="{Binding TimeDisplay}" FontSize="10" FontAttributes="Bold" TextColor="#9F1239" VerticalOptions="Center" />
                                        </Grid>

                                        <Label Text="{Binding Location, StringFormat='Location: {0}'}" FontSize="12" FontAttributes="Bold" TextColor="#1C1917" Margin="0, 2, 0, 0" />
                                        <Label Text="{Binding Advisory}" FontSize="11" TextColor="#57534E" LineHeight="1.2" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- SOS Emergency Call Button -->
                    <Button Text="🚨 SOS EMERGENCY CALL: GUARDHOUSE" 
                            Clicked="OnSosCallClicked"
                            BackgroundColor="#BE123C" 
                            TextColor="White" 
                            FontAttributes="Bold" 
                            FontSize="11" 
                            CornerRadius="12" 
                            HeightRequest="48" 
                            Margin="0, 4, 0, 10" />

                </VerticalStackLayout>
            </ScrollView>
        </Grid>

    </Grid>
</ContentPage>