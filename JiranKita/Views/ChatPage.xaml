<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:JiranKita.Controls"
             xmlns:models="clr-namespace:JiranKita.Models"
             x:Class="JiranKita.Views.ChatPage"
             BackgroundColor="#FAFAF9"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="True">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- ================= 1. CHAT HEADER ================= -->
        <Border Grid.Row="0"
                Stroke="#E7E5E4"
                StrokeThickness="1"
                BackgroundColor="White"
                Padding="14, 10">
            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                <controls:BackButton Grid.Column="0" />

                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                    <Label Text="Taman Seri Kembangan" FontSize="13" FontAttributes="Bold" TextColor="#1C1917" />
                    <HorizontalStackLayout Spacing="4">
                        <Label Text="Neighbourhood Chat ·" FontSize="10" TextColor="#78716C" />
                        <Label Text="Firebase Live 🟢" FontSize="10" FontAttributes="Bold" TextColor="#047857" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Ikon Robot JiranBot -->
                <Border Grid.Column="2"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="#F3E8FF"
                        Stroke="#E9D5FF"
                        HeightRequest="36"
                        WidthRequest="36">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRobotClicked" />
                    </Border.GestureRecognizers>
                    <Label Text="🤖" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>
        </Border>


        <!-- ================= 2. SENARAI MESEJ LIVE FIREBASE ================= -->
        <CollectionView x:Name="MessagesCollectionView"
                        Grid.Row="1"
                        SelectionMode="None"
                        Margin="14, 8">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ChatMessage">
                    <Grid Margin="0, 4">

                        <!-- A. MESEJ DARI JIRAN LAIN (Keluar Sebelah Kiri) -->
                        <VerticalStackLayout HorizontalOptions="Start" MaximumWidthRequest="280" Spacing="3">
                            <VerticalStackLayout.Triggers>
                                <!-- Jika ini mesej kita sendiri, sorokkan panel kiri ini -->
                                <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding IsSelf}" Value="True">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                            </VerticalStackLayout.Triggers>

                            <Label Text="{Binding SenderName}" FontSize="10" FontAttributes="Bold" TextColor="#78716C" Margin="4, 0, 0, 0" />

                            <Border StrokeShape="RoundRectangle 16 16 16 0"
                                    Stroke="#E7E5E4"
                                    BackgroundColor="White"
                                    Padding="12, 10">
                                <Label Text="{Binding MessageText}" FontSize="12" TextColor="#1C1917" LineHeight="1.2" />
                            </Border>

                            <Label Text="{Binding Timestamp, StringFormat='{0:hh:mm tt}'}" FontSize="9" TextColor="#A8A29E" Margin="4, 0, 0, 0" />
                        </VerticalStackLayout>


                        <!-- B. MESEJ KITA SENDIRI (Kotak Hijau) -->
                        <VerticalStackLayout HorizontalOptions="End" MaximumWidthRequest="280" Spacing="3" IsVisible="False">
                            <VerticalStackLayout.Triggers>
                                <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding IsSelf}" Value="True">
                                    <Setter Property="IsVisible" Value="True" />
                                </DataTrigger>
                            </VerticalStackLayout.Triggers>

                            <!-- KOTAK HIJAU: GUNA PENGESAN TEKAN LAMA (LONG PRESS) -->
                            <Border StrokeShape="RoundRectangle 16 16 0 16"
                            BackgroundColor="#047857"
                            Stroke="Transparent"
                            Padding="12, 10">
                                <Border.GestureRecognizers>
                                    <PointerGestureRecognizer PointerPressed="OnMessagePointerPressed"
                                      PointerReleased="OnMessagePointerReleased"
                                      PointerExited="OnMessagePointerReleased" />
                                </Border.GestureRecognizers>

                                <Label Text="{Binding MessageText}" FontSize="12" TextColor="White" LineHeight="1.2" />
                            </Border>

                            <Label Text="{Binding Timestamp, StringFormat='{0:hh:mm tt}'}" FontSize="9" TextColor="#A8A29E" HorizontalOptions="End" Margin="0, 0, 4, 0" />
                        </VerticalStackLayout>

                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>


        <!-- ================= 3. KOTAK INPUT TAIP MESEJ ================= -->
        <Border Grid.Row="2"
                Stroke="#E7E5E4"
                StrokeThickness="1"
                BackgroundColor="White"
                Padding="12, 8">
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">

                <!-- Kotak Taip -->
                <Border Grid.Column="0" StrokeShape="RoundRectangle 12" Stroke="#D6D3D1" BackgroundColor="#FAFAF9" Padding="12, 0">
                    <Entry x:Name="TxtChatMessage" 
                           Placeholder="Type message to neighbours..." 
                           PlaceholderColor="#A8A29E" 
                           FontSize="12" 
                           TextColor="#1C1917"
                           ReturnCommand="{Binding SendCommand}" />
                </Border>

                <!-- Butang Send (➤) -->
                <Border Grid.Column="1" StrokeShape="RoundRectangle 12" BackgroundColor="#047857" Stroke="Transparent" HeightRequest="38" WidthRequest="38">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSendMessageClicked" />
                    </Border.GestureRecognizers>
                    <Label Text="➤" FontSize="14" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

            </Grid>
        </Border>

    </Grid>

</ContentPage>