<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:JiranKita.Controls"
             x:Class="JiranKita.Views.ChatPage"
             BackgroundColor="#FAFAF9"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="True">

    <!-- Grid 3 Baris: Header (Auto), Mesej Chat (*), Kotak Taip (Auto) -->
    <Grid RowDefinitions="Auto, *, Auto">

        <!-- ================= 1. CHAT HEADER ================= -->
        <Border Grid.Row="0"
                Stroke="#E7E5E4"
                StrokeThickness="1"
                BackgroundColor="White"
                Padding="14, 10">
            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">

                <!-- Info Komuniti [DB: precinct.name, total_members, online_count] -->
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                    <Label Text="Taman Seri Kembangan" FontSize="13" FontAttributes="Bold" TextColor="#1C1917" />
                    <HorizontalStackLayout Spacing="4">
                        <Label Text="342 neighbours ·" FontSize="10" TextColor="#78716C" />
                        <Label Text="18 online" FontSize="10" FontAttributes="Bold" TextColor="#047857" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Ikon Kanan: Robot & Menu -->
                <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">

                    <!-- IKON ROBOT JIRANBOT (BILA DITEKAN LOMPAT KE SKRIN BOT) -->
                    <Border StrokeShape="RoundRectangle 10"
                            BackgroundColor="#F3E8FF"
                            Stroke="#E9D5FF"
                            HeightRequest="36"
                            WidthRequest="36">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRobotClicked" />
                        </Border.GestureRecognizers>
                        <Label Text="🤖" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <!-- Menu 3 Titik -->
                    <Label Text="⋮" FontSize="18" FontAttributes="Bold" TextColor="#78716C" VerticalOptions="Center" Margin="2,0" />
                </HorizontalStackLayout>

            </Grid>
        </Border>


        <!-- ================= 2. RUANG MESEJ (SCROLLABLE) ================= -->
        <ScrollView Grid.Row="1" Padding="14">
            <VerticalStackLayout Spacing="12">

                <!-- Pembahagi Tarikh / Masa [DB: message.date_group] -->
                <Border StrokeShape="RoundRectangle 10" BackgroundColor="#F5F5F4" Stroke="Transparent" Padding="8, 3" HorizontalOptions="Center" Margin="0, 4">
                    <Label Text="Yesterday, 10:14 AM" FontSize="10" TextColor="#78716C" />
                </Border>

                <!-- MESEJ JIRAN LAIN (Masuk Kiri) [DB: messages table] -->
                <VerticalStackLayout HorizontalOptions="Start" Spacing="4" MaximumWidthRequest="280">
                    <!-- Nama & Unit Pengirim -->
                    <Label Text="Uncle Lim (Unit A-03)" FontSize="10" FontAttributes="Bold" TextColor="#78716C" Margin="4, 0, 0, 0" />
                    <!-- Kotak Mesej Putih (Bucu bawah kiri tajam) -->
                    <Border StrokeShape="RoundRectangle 16 16 16 0"
                            Stroke="#E7E5E4"
                            BackgroundColor="White"
                            Padding="12, 10">
                        <Label Text="Anyone experiencing low tap water pressure today?" FontSize="12" TextColor="#1C1917" LineHeight="1.2" />
                    </Border>
                </VerticalStackLayout>

                <!-- MESEJ KITA SENDIRI (Keluar Kanan) [DB: messages (sender = current_user)] -->
                <VerticalStackLayout HorizontalOptions="End" Spacing="4" MaximumWidthRequest="280" Margin="0, 4, 0, 0">
                    <!-- Kotak Mesej Hijau (Bucu bawah kanan tajam) -->
                    <Border StrokeShape="RoundRectangle 16 16 0 16"
                            BackgroundColor="#047857"
                            Stroke="Transparent"
                            Padding="12, 10">
                        <Label Text="Yes, since 8:30am. Syabas maintenance is ongoing." FontSize="12" TextColor="White" LineHeight="1.2" />
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>


        <!-- ================= 3. KOTAK TAIP MESEJ BAWAH ================= -->
        <Border Grid.Row="2"
                Stroke="#E7E5E4"
                StrokeThickness="1"
                BackgroundColor="White"
                Padding="12, 8">
            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8">

                <!-- Butang Tambah Dokumen/Gambar (+) -->
                <Border Grid.Column="0" StrokeShape="RoundRectangle 12" BackgroundColor="#F5F5F4" Stroke="#E7E5E4" HeightRequest="38" WidthRequest="38">
                    <Label Text="+" FontSize="18" FontAttributes="Bold" TextColor="#57534E" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <!-- Kotak Input Taip [DB: message.text] -->
                <Border Grid.Column="1" StrokeShape="RoundRectangle 12" Stroke="#D6D3D1" BackgroundColor="#FAFAF9" Padding="12, 0">
                    <Entry x:Name="TxtChatMessage" 
                           Placeholder="Type message to neighbours..." 
                           PlaceholderColor="#A8A29E" 
                           FontSize="12" 
                           TextColor="#1C1917"
                           Focused="OnInputFocused" 
                           Unfocused="OnInputUnfocused" />
                </Border>

                <!-- Butang Hantar Mesej (Send) -->
                <Border Grid.Column="2" StrokeShape="RoundRectangle 12" BackgroundColor="#047857" Stroke="Transparent" HeightRequest="38" WidthRequest="38">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSendMessageClicked" />
                    </Border.GestureRecognizers>
                    <Label Text="➤" FontSize="14" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

            </Grid>
        </Border>

    </Grid>

</ContentPage>