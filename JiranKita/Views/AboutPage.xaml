<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:JiranKita.Controls"
             x:Class="JiranKita.Views.AboutPage"
             BackgroundColor="#FAFAF9"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <!-- Main page container split into two rows: a fixed top navigation bar and a scrollable content area -->
    <Grid RowDefinitions="Auto, *">

        <!-- ================= 1. TOP NAVIGATION BAR ================= -->
        <Border Grid.Row="0"
                Stroke="#E7E5E4"
                StrokeThickness="1"
                BackgroundColor="White"
                Padding="16, 10">

            <!-- 3-Column Grid Layout: Left (Back Button), Center (Page Title), Right (Invisible Spacer to keep title centered) -->
            <Grid ColumnDefinitions="Auto, *, Auto">

                <!-- Custom reusable back button control defined in JiranKita.Controls -->
                <controls:BackButton Grid.Column="0" />

                <!-- Centered Page Title -->
                <Label Grid.Column="1" 
                       Text="ABOUT JIRANKITA" 
                       FontSize="15" 
                       FontAttributes="Bold" 
                       TextColor="#1C1917" 
                       CharacterSpacing="1" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center" />

                <!-- Empty spacer matching the back button's width to visually balance and center the title -->
                <BoxView Grid.Column="2" 
                         WidthRequest="40" 
                         Color="White" />
            </Grid>
        </Border>

        <!-- ================= 2. SCROLLABLE CONTENT AREA ================= -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="20">

                <!-- SECTION A: APPLICATION LOGO & VERSION INFO -->
                <VerticalStackLayout Spacing="6" 
                                     HorizontalOptions="Center" 
                                     Margin="0, 10, 0, 0">

                    <!-- Rounded Green-Bordered Frame for the App Logo -->
                    <Border StrokeShape="RoundRectangle 18"
                            Stroke="#065F46"
                            StrokeThickness="2"
                            BackgroundColor="White"
                            HeightRequest="72"
                            WidthRequest="72"
                            Padding="8"
                            HorizontalOptions="Center">
                        <Image Source="logo_jirankita.png"
                               HeightRequest="60"
                               WidthRequest="60"
                               Aspect="AspectFit"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <!-- Application Name -->
                    <Label Text="JiranKita"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#1C1917"
                           HorizontalOptions="Center"
                           Margin="0, 4, 0, 0" />

                    <!-- App Version Pill Badge (Currently hardcoded as static text, can be bound dynamically via AppInfo) -->
                    <Border StrokeShape="RoundRectangle 12"
                            BackgroundColor="#ECFDF5"
                            Stroke="#A7F3D0"
                            Padding="10, 3"
                            HorizontalOptions="Center">
                        <Label Text="v2.4.0 (Build 108)"
                               FontSize="10"
                               FontAttributes="Bold"
                               TextColor="#065F46" />
                    </Border>
                </VerticalStackLayout>

                <!-- SECTION B: ACADEMIC COURSEWORK SUBMISSION CARD -->
                <Border StrokeShape="RoundRectangle 16"
                        Stroke="#6EE7B7"
                        StrokeThickness="1.5"
                        BackgroundColor="White"
                        Padding="18">
                    <VerticalStackLayout Spacing="14">

                        <!-- Card Section Header and Horizontal Divider Line -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="ACADEMIC COURSEWORK SUBMISSION"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="#065F46"
                                   CharacterSpacing="1" />
                            <BoxView HeightRequest="1" Color="#F5F5F4" />
                        </VerticalStackLayout>

                        <!-- Field 1: Student Developer Full Name -->
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Student Name:"
                                   FontSize="10"
                                   TextColor="#78716C" />
                            <Label Text="Muhammad Fathul Naim bin Abdul Rahim"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#1C1917" />
                        </VerticalStackLayout>

                        <!-- Field 2: University Matriculation ID -->
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Student ID:"
                                   FontSize="10"
                                   TextColor="#78716C" />
                            <Label Text="BSW01085231"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="Black" />
                        </VerticalStackLayout>

                        <!-- Field 3: Coursework Module Details (Note: '&' must be escaped as '&amp;' in valid XAML if used) -->
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Coursework Module:"
                                   FontSize="10"
                                   TextColor="#78716C" />
                            <Label Text="Milestone 3: Mobile App Development (CSNB5123)"
                                   FontSize="11"
                                   TextColor="#292524"
                                   LineHeight="1.3" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>