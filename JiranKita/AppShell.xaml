<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="JiranKita.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:JiranKita"
    xmlns:views="clr-namespace:JiranKita.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="JiranKita"
    Shell.TabBarBackgroundColor="White"
    Shell.TabBarForegroundColor="#047857"
    Shell.TabBarTitleColor="#047857"
    Shell.TabBarUnselectedColor="#78716C">

    <!-- ================= 1. INITIAL ENTRY / AUTHENTICATION SCREEN ================= -->
    <!-- Placed outside <TabBar> so the bottom navigation bar stays hidden before login -->
    <ShellContent
        Title="Welcome"
        ContentTemplate="{DataTemplate views:WelcomePage}"
        Route="WelcomePage" />

    <!-- ================= 2. MAIN NATIVE BOTTOM TAB BAR NAVIGATION ================= -->
    <TabBar>

        <!-- Tab 1: Home Dashboard -->
        <ShellContent
            Title="Home"
            Icon="home.svg"
            Route="HomePage"
            ContentTemplate="{DataTemplate views:HomePage}" />

        <!-- Tab 2: Community Feed -->
        <ShellContent
            Title="Feed"
            Icon="feed.svg"
            Route="FeedPage"
            ContentTemplate="{DataTemplate views:FeedPage}" />

        <!-- Tab 3: Chat Inbox & JiranBot AI Entry Point -->
        <ShellContent
            Title="Chat &amp; AI"
            Icon="chat.svg"
            Route="ChatInboxPage"
            ContentTemplate="{DataTemplate views:ChatInboxPage}" />

        <!-- Tab 4: GIS Hazard & Safety Alerts -->
        <ShellContent
            Title="Alerts"
            Icon="alert.svg"
            Route="AlertsPage"
            ContentTemplate="{DataTemplate views:AlertsPage}" />

        <!-- Tab 5: Resident / JMB Profile & Approvals -->
        <ShellContent
            Title="Profile"
            Icon="profile.svg"
            Route="ProfilePage"
            ContentTemplate="{DataTemplate views:ProfilePage}" />

    </TabBar>

</Shell>