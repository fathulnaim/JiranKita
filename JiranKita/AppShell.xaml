<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="JiranKita.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:JiranKita"
    xmlns:views="clr-namespace:JiranKita.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="JiranKita"
    
    Shell.TabBarBackgroundColor="White"
    Shell.TabBarForegroundColor="#047857"
    Shell.TabBarTitleColor="#047857"
    Shell.TabBarUnselectedColor="#78716C">

    <!-- 1. SKRIN PERMULAAN / AUTH (Tab bar disorok di sini) -->
    <ShellContent
        Title="Welcome"
        ContentTemplate="{DataTemplate views:WelcomePage}"
        Route="WelcomePage" />

    <!-- 2. SISTEM TAB MENU ASLI -->
    <TabBar>

        <!-- Tab 1: Home (Wajib ada Icon!) -->
        <ShellContent
            Title="Home"
            Icon="home.svg"
            Route="HomePage"
            ContentTemplate="{DataTemplate views:HomePage}" />

        <ShellContent
            Title="Feed"
            Icon="feed.svg"
            Route="FeedPage"
            ContentTemplate="{DataTemplate views:FeedPage}" />
        
        <ShellContent
            Title="Chat &amp; AI"
            Icon="chat.svg"
            Route="ChatPage"
            ContentTemplate="{DataTemplate views:ChatPage}" />
        
         <ShellContent
            Title="Alerts"
            Icon="alert.svg"
            Route="AlertsPage"
            ContentTemplate="{DataTemplate views:AlertsPage}" />

        <!-- Tab 2: Profile (Wajib ada Icon!) -->
        <ShellContent
            Title="Profile"
            Icon="profile.svg"
            Route="ProfilePage"
            ContentTemplate="{DataTemplate views:ProfilePage}" />

    </TabBar>

</Shell>