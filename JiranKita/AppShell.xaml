<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="JiranKita.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:JiranKita"
    xmlns:views="clr-namespace:JiranKita.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="JiranKita">

	<ShellContent
    Title="Welcome"
    ContentTemplate="{DataTemplate views:WelcomePage}"
    Route="WelcomePage" />
	
	<ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:login}"
        Route="login" />

</Shell>